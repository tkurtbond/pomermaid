#!/bin/sh
# runcases POMERMAID OUTDIR [CASEDIR]
#
# Runs the case tests: for each CASEDIR/<name>.mmd (test/cases by
# default) and each expected output beside it, <name>.<ext>, where <ext>
# is a format (dump, layout, pic, mp, svg-ms) or "out", runs
#
#     POMERMAID -t <ext> [the words of <name>.args] [of <name>.<ext>.args] <name>.mmd
#
# ("out" gives no -t) in CASEDIR, and compares its standard output with
# <name>.<ext>, its standard error with <name>.<ext>.errors, or
# <name>.errors, or with nothing if there is neither, and its exit status
# with the number in <name>.status, or with 0 if there is no such file.
# A .layout or .pic matches if its numbers are within 0.01 of those
# expected (tools/numcmp), as i386 rounds some the other way.
# Results go in OUTDIR. Prints an "ok   - " or "FAIL - " line for each,
# and exits 1 if any failed.

if [ $# -lt 2 ]; then
  echo "usage: runcases POMERMAID OUTDIR [CASEDIR]" >&2
  exit 2
fi
prog=$1
outdir=$2
casedir=${3:-test/cases}

case $prog in /*) ;; *) prog=$(pwd)/$prog ;; esac
tools=$(cd "$(dirname "$0")" && pwd)
mkdir -p "$outdir" || exit 2
case $outdir in /*) ;; *) outdir=$(pwd)/$outdir ;; esac
cd "$casedir" || exit 2

# Gantt charts' dates are local and depend on today (decisions 14, 16)
TZ=America/New_York; export TZ
SOURCE_DATE_EPOCH=1700000000; export SOURCE_DATE_EPOCH

failed=0
total=0
for mmd in *.mmd; do
  [ -f "$mmd" ] || continue
  name=${mmd%.mmd}
  args=
  [ -f "$name.args" ] && args=$(cat "$name.args")
  for ext in dump layout pic mp svg-ms out; do
    [ -f "$name.$ext" ] || continue
    total=$((total + 1))
    to="-t $ext"
    extargs=
    [ -f "$name.$ext.args" ] && extargs=$(cat "$name.$ext.args")
    [ "$ext" = out ] && to=
    # $to and $args are split into words on purpose
    # shellcheck disable=SC2086
    "$prog" $to $args $extargs "$mmd" > "$outdir/$name.$ext" 2> "$outdir/$name.$ext.err"
    status=$?
    errors=/dev/null
    if [ -f "$name.$ext.errors" ]; then errors=$name.$ext.errors
    elif [ -f "$name.errors" ]; then errors=$name.errors
    fi
    want=0
    [ -f "$name.status" ] && want=$(cat "$name.status")
    # a .layout's and a .pic's numbers may differ by 0.01 (numcmp)
    same=false
    if diff -u "$name.$ext" "$outdir/$name.$ext" > "$outdir/$name.$ext.diff"; then
      same=true
    elif { [ "$ext" = layout ] || [ "$ext" = pic ]; } &&
         "$tools/numcmp" "$name.$ext" "$outdir/$name.$ext"; then
      same=true
    fi
    if [ "$status" -eq "$want" ] && $same &&
       diff -u "$errors" "$outdir/$name.$ext.err" >> "$outdir/$name.$ext.diff"; then
      echo "ok   - $name.$ext"
    else
      echo "FAIL - $name.$ext (status $status)"
      cat "$outdir/$name.$ext.diff"
      failed=$((failed + 1))
    fi
  done
done
echo "$((total - failed)) of $total case tests passed"
[ $failed -eq 0 ]
