MODULE PmSeqMacros;
(* PmSeqMacros: the MetaPost macros of mp/pomermaid-seq.mp, without their comments,
   for the MetaPost writer. Made from mp/pomermaid-seq.mp by tools/mp2mod: do not
   edit it; edit mp/pomermaid-seq.mp. *)

IMPORT PmIO;

PROCEDURE L(s: ARRAY OF CHAR);
BEGIN
  PmIO.WriteString(s); PmIO.WriteLn
END L;

(* Writes the macros *)
PROCEDURE Write*;
BEGIN
  L("numeric pms_maxw, pms_n, pms_ne, pms_nb, pms_mirror, pms_em, pms_px;");
  L("numeric pms_atype[], pms_abox[], pms_acre[], pms_ades[];");
  L("numeric pms_x[], pms_w[], pms_top[], pms_tw[], pms_th[], pms_ly[];");
  L("numeric pms_lifea[], pms_lifeb[], pms_foot[], pms_footer[], pms_bw[];");
  L("numeric pms_bfill[], pms_btw[], pms_bth[];");
  L("numeric pms_bxa[], pms_bya[], pms_bxb[], pms_byb[], pms_btx[], pms_bty[];");
  L("numeric pms_ek[], pms_efrom[], pms_eto[], pms_edot[], pms_ehead[], pms_etail[];");
  L("numeric pms_eact[], pms_ecto[], pms_ecfrom[], pms_eplace[], pms_eblock[], pms_efill[];");
  L("numeric pms_ga[], pms_gb[], pms_gc[], pms_gd[], pms_ge[], pms_gtx[], pms_gty[];");
  L("numeric pms_gtw[], pms_gth[], pms_gself[];");
  L("numeric pms_gap[][], pms_stack[], pms_lev[];");
  L("numeric pms_fr[], pms_fpar[], pms_fhas[], pms_flo[], pms_fhi[], pms_fns[];");
  L("numeric pms_fxa[], pms_fya[], pms_fxb[], pms_fyb[], pms_flw[], pms_flh[];");
  L("numeric pms_ftw[], pms_ftx[], pms_fty[], pms_sy[][], pms_stw[][], pms_sty[][];");
  L("numeric pms_rxa[], pms_rya[], pms_rxb[], pms_ryb[], pms_rbelow[];");
  L("numeric pms_nf, pms_nbar, pms_open, pms_y, pms_liney, pms_lastline, pms_h, pms_bandh;");
  L("string pms_alab[], pms_btitle[], pms_enum[], pms_etext[], pms_kname[];");
  L("picture pms_apic[], pms_bpic[], pms_epic[], pms_flpic[], pms_ftpic[], pms_spic[][];");
  L("color pms_c[];");
  L('string pms_title; pms_title := "";');
  L("numeric pms_cafill, pms_caline, pms_catext, pms_clife, pms_csig, pms_csigtext;");
  L("numeric pms_clfill, pms_clline, pms_cltext, pms_clooptext, pms_cnfill, pms_cnline;");
  L("numeric pms_cntext, pms_cbfill, pms_cbline, pms_cnum, pms_cnumtext, pms_ctitle;");
  L("numeric pms_cboxline;");
  L('pms_kname[0] := "loop"; pms_kname[1] := "opt"; pms_kname[2] := "alt";');
  L('pms_kname[3] := "par"; pms_kname[4] := "par"; pms_kname[5] := "critical";');
  L('pms_kname[6] := "break"; pms_kname[7] := "";');
  L('pms_kname[8] := "try"; pms_kname[9] := "section"; pms_kname[10] := "ref";');
  L("def pms_begin(expr mw, n, ne, nb, m) =");
  L("  pms_maxw := mw; pms_n := n; pms_ne := ne; pms_nb := nb; pms_mirror := m;");
  L('  pms_title := "";');
  L("enddef;");
  L("def pms_colour(expr c, r, g, b) = pms_c[c] := (r, g, b); enddef;");
  L("def pms_theme(expr af, al, at, li, sg, st, lf, ll, lt, ot, nf, nl, nt, bf, bl, nu, ut, ti, bx) =");
  L("  pms_cafill := af; pms_caline := al; pms_catext := at; pms_clife := li;");
  L("  pms_csig := sg; pms_csigtext := st; pms_clfill := lf; pms_clline := ll;");
  L("  pms_cltext := lt; pms_clooptext := ot; pms_cnfill := nf; pms_cnline := nl;");
  L("  pms_cntext := nt; pms_cbfill := bf; pms_cbline := bl; pms_cnum := nu;");
  L("  pms_cnumtext := ut; pms_ctitle := ti; pms_cboxline := bx;");
  L("enddef;");
  L("def pms_box(expr k, f, s) = pms_bfill[k] := f; pms_btitle[k] := s; enddef;");
  L("def pms_actor(expr i, t, bx, cr, ds, s) =");
  L("  pms_atype[i] := t; pms_abox[i] := bx; pms_acre[i] := cr; pms_ades[i] := ds;");
  L("  pms_alab[i] := s;");
  L("enddef;");
  L("def pms_event(expr q, k, f, t, s) =");
  L("  pms_ek[q] := k; pms_efrom[q] := f; pms_eto[q] := t; pms_etext[q] := s;");
  L("  pms_edot[q] := 0; pms_ehead[q] := 0; pms_etail[q] := 0; pms_eact[q] := 0;");
  L("  pms_ecto[q] := 0; pms_ecfrom[q] := 0; pms_eplace[q] := 0; pms_eblock[q] := 0;");
  L('  pms_efill[q] := -1; pms_enum[q] := "";');
  L("enddef;");
  L("def pms_msg(expr q, f, t, dt, hd, tl, ac, ct, cf, nm, s) =");
  L("  pms_event(q, 0, f, t, s);");
  L("  pms_edot[q] := dt; pms_ehead[q] := hd; pms_etail[q] := tl; pms_eact[q] := ac;");
  L("  pms_ecto[q] := ct; pms_ecfrom[q] := cf; pms_enum[q] := nm;");
  L("enddef;");
  L("def pms_note(expr q, f, t, pl, s) = pms_event(q, 1, f, t, s); pms_eplace[q] := pl; enddef;");
  L("def pms_start(expr q, k, f, s) =");
  L("  pms_event(q, 2, -1, -1, s); pms_eblock[q] := k; pms_efill[q] := f;");
  L("enddef;");
  L("def pms_else(expr q, s) = pms_event(q, 3, -1, -1, s); enddef;");
  L('def pms_stop(expr q) = pms_event(q, 4, -1, -1, ""); enddef;');
  L('def pms_activate(expr q, a) = pms_event(q, 5, a, a, ""); enddef;');
  L('def pms_deactivate(expr q, a) = pms_event(q, 6, a, a, ""); enddef;');
  L("vardef pms_text(expr s) =");
  L('  textext("\framed[frame=off,offset=0pt,align=middle]{" & s & "}")');
  L("enddef;");
  L("vardef pms_picw(expr p) = xpart urcorner p - xpart llcorner p enddef;");
  L("vardef pms_pich(expr p) = ypart urcorner p - ypart llcorner p enddef;");
  L("def pms_measure(suffix p, w, h)(expr s) =");
  L('  if s = "": p := nullpicture; w := 0; h := 0;');
  L("  else: p := pms_text(s); w := pms_picw(p); h := pms_pich(p); fi");
  L("enddef;");
  L("vardef pms_up(expr a, b) = (a, -b) enddef;");
  L("def pms_need(expr a, b, v) =");
  L("  if a < b:");
  L("    if v > pms_gap[a][b]: pms_gap[a][b] := v; fi");
  L("  elseif b < a:");
  L("    if v > pms_gap[b][a]: pms_gap[b][a] := v; fi");
  L("  fi");
  L("enddef;");
  L("def pms_columns =");
  L("  for i = 0 upto pms_n - 1: for j = 0 upto pms_n - 1: pms_gap[i][j] := 0; endfor endfor");
  L("  for i = 0 upto pms_n - 1:");
  L("    pms_bw[i] := pms_w[i];");
  L("    if pms_abox[i] >= 0:");
  L('      if pms_btitle[pms_abox[i]] <> "":');
  L("        pms_alone := 1;");
  L("        for j = 0 upto pms_n - 1:");
  L("          if (j <> i) and (pms_abox[j] = pms_abox[i]): pms_alone := 0; fi");
  L("        endfor");
  L("        if pms_alone = 1: pms_bw[i] := max(pms_bw[i], pms_btw[pms_abox[i]]); fi");
  L("      fi");
  L("    fi");
  L("  endfor");
  L("  for i = 0 upto pms_n - 2:");
  L("    pms_v := (pms_bw[i] + pms_bw[i + 1]) / 2 + 50pms_px;");
  L("    if pms_abox[i] <> pms_abox[i + 1]: pms_v := pms_v + 20pms_px; fi");
  L("    pms_need(i, i + 1, pms_v);");
  L("  endfor");
  L("  for q = 0 upto pms_ne - 1:");
  L("    pms_i := pms_efrom[q]; pms_j := pms_eto[q]; pms_v := pms_gtw[q];");
  L("    if pms_ek[q] = 0:");
  L("      if pms_i <> pms_j: pms_need(pms_i, pms_j, pms_v + 30pms_px);");
  L("      elseif pms_i < pms_n - 1: pms_need(pms_i, pms_i + 1, max(pms_v, 30pms_px) + 25pms_px);");
  L("      fi");
  L("    elseif pms_ek[q] = 1:");
  L("      pms_v := pms_v + 20pms_px;");
  L("      if pms_eplace[q] = 1:");
  L("        if pms_i < pms_n - 1: pms_need(pms_i, pms_i + 1, pms_v + 20pms_px); fi");
  L("      elseif pms_eplace[q] = 0:");
  L("        if pms_i > 0: pms_need(pms_i - 1, pms_i, pms_v + 20pms_px); fi");
  L("      elseif pms_i = pms_j:");
  L("        if pms_i < pms_n - 1: pms_need(pms_i, pms_i + 1, pms_v / 2 + 10pms_px); fi");
  L("        if pms_i > 0: pms_need(pms_i - 1, pms_i, pms_v / 2 + 10pms_px); fi");
  L("      else: pms_need(pms_i, pms_j, pms_v - 50pms_px);");
  L("      fi");
  L("    fi");
  L("  endfor");
  L("  if pms_n > 0: pms_x[0] := 0; fi");
  L("  for j = 1 upto pms_n - 1:");
  L("    pms_v := pms_x[0] + pms_gap[0][j];");
  L("    for i = 1 upto j - 1: pms_v := max(pms_v, pms_x[i] + pms_gap[i][j]); endfor");
  L("    pms_x[j] := pms_v;");
  L("  endfor");
  L("enddef;");
  L("vardef pms_redge(expr i, k) =");
  L("  if k = 0: pms_x[i] else: pms_x[i] + 5pms_px + (k - 1) * 5pms_px fi");
  L("enddef;");
  L("vardef pms_ledge(expr i, k) =");
  L("  if k = 0: pms_x[i] else: pms_x[i] - 5pms_px + (k - 1) * 5pms_px fi");
  L("enddef;");
  L("def pms_startbar(expr i, yy) =");
  L("  pms_rxa[pms_nbar] := pms_x[i] - 5pms_px + pms_lev[i] * 5pms_px;");
  L("  pms_rxb[pms_nbar] := pms_rxa[pms_nbar] + 10pms_px;");
  L("  pms_rya[pms_nbar] := yy; pms_ryb[pms_nbar] := yy;");
  L("  pms_rbelow[pms_nbar] := pms_stack[i]; pms_stack[i] := pms_nbar;");
  L("  pms_lev[i] := pms_lev[i] + 1; pms_nbar := pms_nbar + 1;");
  L("enddef;");
  L("def pms_endbar(expr i, yy) =");
  L("  if pms_stack[i] >= 0:");
  L("    pms_ryb[pms_stack[i]] := max(yy, pms_rya[pms_stack[i]]);");
  L("    pms_stack[i] := pms_rbelow[pms_stack[i]]; pms_lev[i] := pms_lev[i] - 1;");
  L("  fi");
  L("enddef;");
  L("def pms_holds(expr lo, hi) =");
  L("  if pms_open >= 0:");
  L("    if pms_fhas[pms_open] = 0:");
  L("      pms_flo[pms_open] := lo; pms_fhi[pms_open] := hi; pms_fhas[pms_open] := 1;");
  L("    else:");
  L("      pms_flo[pms_open] := min(pms_flo[pms_open], lo);");
  L("      pms_fhi[pms_open] := max(pms_fhi[pms_open], hi);");
  L("    fi");
  L("  fi");
  L("enddef;");
  L("def pms_lmsg(expr q) =");
  L("  pms_i := pms_efrom[q]; pms_j := pms_eto[q];");
  L("  pms_y := pms_y + 20pms_px;");
  L("  pms_liney := pms_y + pms_gth[q];");
  L("  if pms_gth[q] > 0: pms_liney := pms_liney + 6pms_px; fi");
  L("  pms_gty[q] := pms_liney - 6pms_px - pms_gth[q] / 2;");
  L("  if pms_i = pms_j:");
  L("    pms_gself[q] := 1;");
  L("    pms_ga[q] := pms_redge(pms_i, pms_lev[pms_i]); pms_gb[q] := pms_liney;");
  L("    pms_gc[q] := pms_ga[q] + 30pms_px; pms_gd[q] := pms_liney + 20pms_px;");
  L("    pms_k := pms_lev[pms_i] + pms_eact[q];");
  L("    pms_ge[q] := pms_redge(pms_i, pms_k);");
  L("    pms_gtx[q] := pms_ga[q] + 5pms_px + pms_gtw[q] / 2;");
  L("    pms_holds(min(pms_ga[q], pms_gtx[q] - pms_gtw[q] / 2),");
  L("      max(pms_gc[q], pms_gtx[q] + pms_gtw[q] / 2));");
  L("    pms_y := pms_gd[q];");
  L("  else:");
  L("    if pms_acre[pms_j] = q: pms_liney := max(pms_liney, pms_y + pms_h / 2); fi");
  L("    pms_gb[q] := pms_liney; pms_gd[q] := pms_liney;");
  L("    pms_k := pms_lev[pms_j] + pms_eact[q];");
  L("    if pms_x[pms_i] < pms_x[pms_j]:");
  L("      pms_ga[q] := pms_redge(pms_i, pms_lev[pms_i]); pms_gc[q] := pms_ledge(pms_j, pms_k);");
  L("      if pms_acre[pms_j] = q: pms_gc[q] := pms_x[pms_j] - pms_w[pms_j] / 2; fi");
  L("    else:");
  L("      pms_ga[q] := pms_ledge(pms_i, pms_lev[pms_i]); pms_gc[q] := pms_redge(pms_j, pms_k);");
  L("      if pms_acre[pms_j] = q: pms_gc[q] := pms_x[pms_j] + pms_w[pms_j] / 2; fi");
  L("    fi");
  L("    pms_ge[q] := pms_gc[q];");
  L("    pms_gtx[q] := (pms_ga[q] + pms_gc[q]) / 2;");
  L("    pms_holds(min(pms_ga[q], pms_gc[q], pms_gtx[q] - pms_gtw[q] / 2),");
  L("      max(pms_ga[q], pms_gc[q], pms_gtx[q] + pms_gtw[q] / 2));");
  L("    pms_y := pms_liney;");
  L("    if pms_acre[pms_j] = q:");
  L("      pms_top[pms_j] := pms_liney - pms_h / 2; pms_y := pms_liney + pms_h / 2;");
  L("    fi");
  L("  fi");
  L("  if pms_ades[pms_j] = q: pms_lifeb[pms_j] := pms_liney; fi");
  L("  if pms_ades[pms_i] = q: pms_lifeb[pms_i] := pms_liney; fi");
  L("  pms_lastline := pms_liney;");
  L("enddef;");
  L("def pms_lnote(expr q) =");
  L("  pms_i := pms_efrom[q]; pms_j := pms_eto[q];");
  L("  pms_v := pms_gtw[q] + 20pms_px; pms_hh := pms_gth[q] + 20pms_px;");
  L("  pms_y := pms_y + 10pms_px;");
  L("  if pms_eplace[q] = 1:");
  L("    pms_ga[q] := pms_redge(pms_i, pms_lev[pms_i]) + 10pms_px; pms_gc[q] := pms_ga[q] + pms_v;");
  L("  elseif pms_eplace[q] = 0:");
  L("    pms_gc[q] := pms_ledge(pms_i, pms_lev[pms_i]) - 10pms_px; pms_ga[q] := pms_gc[q] - pms_v;");
  L("  elseif pms_i = pms_j:");
  L("    pms_ga[q] := pms_x[pms_i] - pms_v / 2; pms_gc[q] := pms_ga[q] + pms_v;");
  L("  else:");
  L("    pms_ga[q] := min(pms_x[pms_i], pms_x[pms_j]) - 25pms_px;");
  L("    pms_gc[q] := max(pms_x[pms_i], pms_x[pms_j]) + 25pms_px;");
  L("    if pms_gc[q] - pms_ga[q] < pms_v:");
  L("      pms_ga[q] := (pms_ga[q] + pms_gc[q] - pms_v) / 2; pms_gc[q] := pms_ga[q] + pms_v;");
  L("    fi");
  L("  fi");
  L("  pms_gb[q] := pms_y; pms_gd[q] := pms_y + pms_hh;");
  L("  pms_gtx[q] := (pms_ga[q] + pms_gc[q]) / 2; pms_gty[q] := pms_y + pms_hh / 2;");
  L("  pms_ge[q] := pms_gc[q];");
  L("  pms_holds(pms_ga[q], pms_gc[q]);");
  L("  pms_y := pms_gd[q]; pms_lastline := pms_y;");
  L("enddef;");
  L("def pms_lstart(expr q) =");
  L("  pms_y := pms_y + 10pms_px;");
  L("  pms_fr[pms_nf] := q; pms_nf := pms_nf + 1;");
  L("  pms_fya[q] := pms_y; pms_fns[q] := 0; pms_fhas[q] := 0; pms_fpar[q] := pms_open;");
  L("  pms_hh := 0; pms_flw[q] := 0; pms_flh[q] := 0; pms_ftw[q] := 0;");
  L("  if pms_eblock[q] <> 7:");
  L('    pms_flpic[q] := pms_text("{\bf " & pms_kname[pms_eblock[q]] & "}");');
  L("    pms_flw[q] := max(50pms_px, pms_picw(pms_flpic[q]) + 20pms_px);");
  L("    pms_flh[q] := max(20pms_px, pms_pich(pms_flpic[q]) + 4pms_px);");
  L("    pms_hh := pms_flh[q];");
  L('    if pms_etext[q] <> "":');
  L('      pms_ftpic[q] := pms_text("[" & pms_etext[q] & "]");');
  L("      pms_ftw[q] := pms_picw(pms_ftpic[q]); pms_hh := max(pms_hh, pms_pich(pms_ftpic[q]));");
  L("    fi");
  L("  fi");
  L("  pms_fty[q] := pms_y + pms_hh / 2;");
  L("  pms_y := pms_y + pms_hh; pms_open := q; pms_lastline := pms_y;");
  L("enddef;");
  L("def pms_lelse(expr q) =");
  L("  if pms_open >= 0:");
  L("    pms_f := pms_open; pms_k := pms_fns[pms_f];");
  L("    pms_y := pms_y + 10pms_px;");
  L("    pms_sy[pms_f][pms_k] := pms_y; pms_stw[pms_f][pms_k] := 0; pms_hh := 0;");
  L('    if pms_etext[q] <> "":');
  L('      pms_spic[pms_f][pms_k] := pms_text("[" & pms_etext[q] & "]");');
  L("      pms_stw[pms_f][pms_k] := pms_picw(pms_spic[pms_f][pms_k]);");
  L("      pms_hh := pms_pich(pms_spic[pms_f][pms_k]);");
  L("    fi");
  L("    pms_sty[pms_f][pms_k] := pms_y + 3pms_px + pms_hh / 2;");
  L("    if pms_hh > 0: pms_y := pms_y + 3pms_px + pms_hh; fi");
  L("    pms_fns[pms_f] := pms_k + 1; pms_lastline := pms_y;");
  L("  fi");
  L("enddef;");
  L("def pms_lstop =");
  L("  if pms_open >= 0:");
  L("    pms_f := pms_open;");
  L("    pms_y := pms_y + 10pms_px; pms_fyb[pms_f] := pms_y;");
  L("    if pms_fhas[pms_f] = 0:");
  L("      pms_flo[pms_f] := if pms_n > 0: pms_x[0] else: 0 fi; pms_fhi[pms_f] := pms_flo[pms_f];");
  L("    fi");
  L("    pms_fxa[pms_f] := pms_flo[pms_f] - 10pms_px; pms_fxb[pms_f] := pms_fhi[pms_f] + 10pms_px;");
  L("    pms_v := pms_ftw[pms_f] + 2 * pms_flw[pms_f] + 20pms_px;");
  L("    for k = 0 upto pms_fns[pms_f] - 1: pms_v := max(pms_v, pms_stw[pms_f][k] + 20pms_px); endfor");
  L("    if pms_fxb[pms_f] - pms_fxa[pms_f] < pms_v:");
  L("      pms_hh := (pms_fxa[pms_f] + pms_fxb[pms_f]) / 2;");
  L("      pms_fxa[pms_f] := pms_hh - pms_v / 2; pms_fxb[pms_f] := pms_hh + pms_v / 2;");
  L("    fi");
  L("    pms_ftx[pms_f] := (pms_fxa[pms_f] + pms_fxb[pms_f]) / 2;");
  L("    pms_open := pms_fpar[pms_f];");
  L("    pms_holds(pms_fxa[pms_f], pms_fxb[pms_f]);");
  L("    pms_lastline := pms_y;");
  L("  fi");
  L("enddef;");
  L("vardef pms_icon(expr t) = (t >= 1) and (t <= 4) enddef;");
  L("def pms_layout =");
  L('  pms_em := pms_picw(textext("\hbox to 1em{}")); pms_px := pms_em / 16;');
  L("  pms_h := 65pms_px;");
  L("  for i = 0 upto pms_n - 1:");
  L("    pms_stack[i] := -1; pms_lev[i] := 0;");
  L("    pms_measure(pms_apic[i], pms_tw[i], pms_th[i])(pms_alab[i]);");
  L("    pms_w[i] := max(150pms_px, pms_tw[i] + 20pms_px);");
  L("    if pms_icon(pms_atype[i]): pms_hh := 55pms_px + pms_th[i];");
  L("    else: pms_hh := pms_th[i] + 20pms_px; fi");
  L("    pms_h := max(pms_h, pms_hh);");
  L("  endfor");
  L("  for k = 0 upto pms_nb - 1: pms_measure(pms_bpic[k], pms_btw[k], pms_bth[k])(pms_btitle[k]); endfor");
  L("  for q = 0 upto pms_ne - 1:");
  L("    pms_ga[q] := 0; pms_gb[q] := 0; pms_gc[q] := 0; pms_gd[q] := 0; pms_ge[q] := 0;");
  L("    pms_gtx[q] := 0; pms_gty[q] := 0; pms_gself[q] := 0;");
  L("    if pms_ek[q] <= 1: pms_measure(pms_epic[q], pms_gtw[q], pms_gth[q])(pms_etext[q]);");
  L("    else: pms_gtw[q] := 0; pms_gth[q] := 0; fi");
  L("  endfor");
  L("  pms_columns;");
  L("  pms_bandh := 0;");
  L("  for k = 0 upto pms_nb - 1:");
  L('    if pms_btitle[k] <> "": pms_bandh := max(pms_bandh, pms_bth[k] + 5pms_px); fi');
  L("  endfor");
  L("  pms_v := if pms_nb > 0: 10pms_px + pms_bandh else: 0 fi;");
  L("  for i = 0 upto pms_n - 1: pms_top[i] := pms_v; endfor");
  L("  pms_y := pms_v + pms_h; pms_lastline := pms_y;");
  L("  pms_open := -1; pms_nf := 0; pms_nbar := 0;");
  L("  for q = 0 upto pms_ne - 1:");
  L("    if pms_ek[q] = 0: pms_lmsg(q);");
  L("    elseif pms_ek[q] = 1: pms_lnote(q);");
  L("    elseif pms_ek[q] = 2: pms_lstart(q);");
  L("    elseif pms_ek[q] = 3: pms_lelse(q);");
  L("    elseif pms_ek[q] = 4: pms_lstop;");
  L("    elseif pms_ek[q] = 5: pms_startbar(pms_efrom[q], pms_lastline);");
  L("    else: pms_endbar(pms_efrom[q], pms_lastline);");
  L("    fi");
  L("  endfor");
  L("  forever: exitif pms_open < 0; pms_lstop; endfor");
  L("  for i = 0 upto pms_n - 1:");
  L("    forever: exitif pms_stack[i] < 0; pms_endbar(i, pms_y); endfor");
  L("  endfor");
  L("  pms_y := pms_y + 20pms_px;");
  L("  pms_bottom := pms_y;");
  L("  for i = 0 upto pms_n - 1:");
  L("    if pms_icon(pms_atype[i]):");
  L("      pms_ly[i] := pms_top[i] + 45pms_px + pms_th[i] / 2; pms_lifea[i] := pms_ly[i] + pms_th[i] / 2;");
  L("    else:");
  L("      pms_ly[i] := pms_top[i] + pms_h / 2; pms_lifea[i] := pms_top[i] + pms_h;");
  L("    fi");
  L("    pms_footer[i] := if (pms_ades[i] < 0) and (pms_mirror = 1): 1 else: 0 fi;");
  L("    if pms_ades[i] < 0: pms_lifeb[i] := pms_y; fi");
  L("    pms_foot[i] := pms_y;");
  L("    if pms_footer[i] = 1: pms_bottom := pms_y + pms_h; fi");
  L("  endfor");
  L("  for k = 0 upto pms_nb - 1:");
  L("    pms_bxa[k] := 0; pms_bxb[k] := 0; pms_v := 0;");
  L("    for i = 0 upto pms_n - 1:");
  L("      if pms_abox[i] = k:");
  L("        if pms_v = 0:");
  L("          pms_bxa[k] := pms_x[i] - pms_w[i] / 2; pms_bxb[k] := pms_x[i] + pms_w[i] / 2; pms_v := 1;");
  L("        else:");
  L("          pms_bxa[k] := min(pms_bxa[k], pms_x[i] - pms_w[i] / 2);");
  L("          pms_bxb[k] := max(pms_bxb[k], pms_x[i] + pms_w[i] / 2);");
  L("        fi");
  L("      fi");
  L("    endfor");
  L("    pms_bxa[k] := pms_bxa[k] - 10pms_px; pms_bxb[k] := pms_bxb[k] + 10pms_px;");
  L('    if pms_btitle[k] <> "":');
  L("      if pms_bxb[k] - pms_bxa[k] < pms_btw[k] + 20pms_px:");
  L("        pms_v := (pms_bxa[k] + pms_bxb[k]) / 2;");
  L("        pms_bxa[k] := pms_v - pms_btw[k] / 2 - 10pms_px; pms_bxb[k] := pms_v + pms_btw[k] / 2 + 10pms_px;");
  L("      fi");
  L("    fi");
  L("    pms_bya[k] := 0; pms_byb[k] := pms_bottom + 10pms_px;");
  L("    pms_btx[k] := (pms_bxa[k] + pms_bxb[k]) / 2; pms_bty[k] := (10pms_px + pms_bandh) / 2;");
  L("  endfor");
  L("enddef;");
  L("vardef pms_col(expr c) = if c >= 0: pms_c[c] else: black fi enddef;");
  L("def pms_paint(expr p, f, l, w, d) =");
  L("  if (f >= 0) and (cycle p): fill p withcolor pms_c[f]; fi");
  L("  if l >= 0:");
  L("    if d > 0:");
  L("      draw p withpen pencircle scaled (w * pms_px) withcolor pms_c[l]");
  L("        dashed dashpattern(on (d * pms_px) off (d * pms_px));");
  L("    else:");
  L("      draw p withpen pencircle scaled (w * pms_px) withcolor pms_c[l];");
  L("    fi");
  L("  fi");
  L("enddef;");
  L("vardef pms_rect(expr xa, ya, xb, yb) =");
  L("  pms_up(xa, ya) -- pms_up(xb, ya) -- pms_up(xb, yb) -- pms_up(xa, yb) -- cycle");
  L("enddef;");
  L("vardef pms_line(expr xa, ya, xb, yb) = pms_up(xa, ya) -- pms_up(xb, yb) enddef;");
  L("vardef pms_circle(expr cx, cy, r) = fullcircle scaled (2r) shifted pms_up(cx, cy) enddef;");
  L("vardef pms_rrect(expr xa, ya, xb, yb, r) =");
  L("  save k; k := r * 0.5523;");
  L("  (pms_up(xa + r, yb) -- pms_up(xb - r, yb) .. controls pms_up(xb - r + k, yb) and pms_up(xb, yb - r + k)");
  L("   .. pms_up(xb, yb - r) -- pms_up(xb, ya + r) .. controls pms_up(xb, ya + r - k) and pms_up(xb - r + k, ya)");
  L("   .. pms_up(xb - r, ya) -- pms_up(xa + r, ya) .. controls pms_up(xa + r - k, ya) and pms_up(xa, ya + r - k)");
  L("   .. pms_up(xa, ya + r) -- pms_up(xa, yb - r) .. controls pms_up(xa, yb - r + k) and pms_up(xa + r - k, yb)");
  L("   .. cycle)");
  L("enddef;");
  L("def pms_put(expr p, cx, cy, c) =");
  L("  draw p shifted (pms_up(cx, cy) - (llcorner p + urcorner p) / 2) withcolor pms_col(c);");
  L("enddef;");
  L("def pms_fig(expr p) = pms_paint(p, pms_cafill, pms_caline, 1.5, 0); enddef;");
  L("def pms_participant(expr i, yy) =");
  L("  begingroup save cx, ww, hh, xa, xb, r, cy, rx, ry, t, pa, pb; path pa, pb;");
  L("  cx := pms_x[i]; ww := pms_w[i]; hh := pms_h; xa := cx - ww / 2; xb := cx + ww / 2;");
  L("  t := pms_atype[i];");
  L("  if t = 1:");
  L("    r := 7pms_px; cy := yy + r;");
  L("    pms_fig(pms_circle(cx, cy, r));");
  L("    pms_fig(pms_line(cx, cy + r, cx, yy + 28pms_px));");
  L("    pms_fig(pms_line(cx - 12pms_px, yy + 19pms_px, cx + 12pms_px, yy + 19pms_px));");
  L("    pms_fig(pms_line(cx, yy + 28pms_px, cx - 10pms_px, yy + 40pms_px));");
  L("    pms_fig(pms_line(cx, yy + 28pms_px, cx + 10pms_px, yy + 40pms_px));");
  L("  elseif t = 2:");
  L("    r := 14pms_px; cy := yy + 20pms_px;");
  L("    pms_fig(pms_line(cx - 22pms_px, cy - r, cx - 22pms_px, cy + r));");
  L("    pms_fig(pms_line(cx - 22pms_px, cy, cx + 4pms_px - r, cy));");
  L("    pms_fig(pms_circle(cx + 4pms_px, cy, r));");
  L("  elseif t = 3:");
  L("    r := 14pms_px; cy := yy + 23pms_px;");
  L("    pms_fig(pms_circle(cx, cy, r));");
  L("    pms_fig(pms_line(cx + 2pms_px, cy - r, cx + 8pms_px, cy - r - 5pms_px));");
  L("    pms_fig(pms_line(cx + 2pms_px, cy - r, cx + 8pms_px, cy - r + 5pms_px));");
  L("  elseif t = 4:");
  L("    r := 14pms_px; cy := yy + r + 4pms_px;");
  L("    pms_fig(pms_circle(cx, cy, r));");
  L("    pms_fig(pms_line(cx - r, cy + r + 4pms_px, cx + r, cy + r + 4pms_px));");
  L("  elseif t = 5:");
  L("    ry := min(8pms_px, hh / 6);");
  L("    pa := fullcircle xscaled ww yscaled (2ry) shifted pms_up(cx, yy + ry);");
  L("    pb := fullcircle xscaled ww yscaled (2ry) shifted pms_up(cx, yy + hh - ry);");
  L("    pms_paint(subpath (0, 4) of pa -- subpath (4, 8) of pb -- cycle, pms_cafill, pms_caline, 1, 0);");
  L("    pms_paint(subpath (4, 8) of pa, -1, pms_caline, 1, 0);");
  L("  elseif t = 7:");
  L("    rx := min(8pms_px, ww / 8);");
  L("    pa := fullcircle xscaled (2rx) yscaled hh shifted pms_up(xb - rx, yy + hh / 2);");
  L("    pb := fullcircle xscaled (2rx) yscaled hh shifted pms_up(xa + rx, yy + hh / 2);");
  L("    pms_paint((subpath (6, 8) of pa & subpath (0, 2) of pa) -- subpath (2, 6) of pb -- cycle,");
  L("      pms_cafill, pms_caline, 1, 0);");
  L("    pms_paint(subpath (2, 6) of pa, -1, pms_caline, 1, 0);");
  L("  elseif t = 6:");
  L("    pms_paint(pms_rect(xa + 6pms_px, yy, xb, yy + hh - 6pms_px), pms_cafill, pms_caline, 1, 0);");
  L("    pms_paint(pms_rect(xa, yy + 6pms_px, xb - 6pms_px, yy + hh), pms_cafill, pms_caline, 1, 0);");
  L("  else:");
  L("    pms_paint(pms_rrect(xa, yy, xb, yy + hh, 3pms_px), pms_cafill, pms_caline, 1, 0);");
  L("  fi");
  L("  pms_put(pms_apic[i], cx, yy + pms_ly[i] - pms_top[i], pms_catext);");
  L("  endgroup");
  L("enddef;");
  L("vardef pms_hp(expr al, sd) =");
  L("  pms_up(pms_hx - pms_hux * al * pms_px + pms_huy * sd * pms_px,");
  L("    pms_hy - pms_huy * al * pms_px - pms_hux * sd * pms_px)");
  L("enddef;");
  L("def pms_head(expr k, hx, hy, ux, uy) =");
  L("  pms_hx := hx; pms_hy := hy; pms_hux := ux; pms_huy := uy;");
  L("  if k = 1:");
  L("    pms_paint(pms_hp(0, 0) -- pms_hp(10, 5) -- pms_hp(10, -5) -- cycle, pms_csig, -1, 0, 0);");
  L("  elseif k = 2:");
  L("    pms_paint(pms_hp(0, 0) -- pms_hp(10, 6) -- pms_hp(5, 0) -- pms_hp(10, -6) -- cycle,");
  L("      pms_csig, -1, 0, 0);");
  L("  elseif k = 4:");
  L("    pms_paint(pms_hp(0, 0) -- pms_hp(10, 8) -- pms_hp(10, 0) -- cycle, pms_csig, -1, 0, 0);");
  L("  elseif k = 5:");
  L("    pms_paint(pms_hp(0, 0) -- pms_hp(10, -8) -- pms_hp(10, 0) -- cycle, pms_csig, -1, 0, 0);");
  L("  elseif k = 6:");
  L("    pms_paint(pms_hp(0, 0) -- pms_hp(7, 7), -1, pms_csig, 1.5, 0);");
  L("  elseif k = 7:");
  L("    pms_paint(pms_hp(0, 0) -- pms_hp(7, -7), -1, pms_csig, 1.5, 0);");
  L("  elseif k = 3:");
  L("    pms_paint(pms_hp(8, 4) -- pms_hp(0, -4), -1, pms_csig, 1.5, 0);");
  L("    pms_paint(pms_hp(8, -4) -- pms_hp(0, 4), -1, pms_csig, 1.5, 0);");
  L("  fi");
  L("enddef;");
  L("vardef pms_sign(expr v) = if v < 0: -1 elseif v > 0: 1 else: 0 fi enddef;");
  L("def pms_drawmsg(expr q) =");
  L("  begingroup save d, ux, uy, ex, ey, p; picture p;");
  L("  d := 3 * pms_edot[q];");
  L("  if pms_gself[q] = 1:");
  L("    pms_paint(pms_up(pms_ga[q], pms_gb[q]) -- pms_up(pms_gc[q], pms_gb[q])");
  L("      -- pms_up(pms_gc[q], pms_gd[q]) -- pms_up(pms_ge[q], pms_gd[q]), -1, pms_csig, 1.5, d);");
  L("    ex := pms_ge[q]; ey := pms_gd[q];");
  L("    pms_head(pms_ehead[q], ex, ey, -1, 0); pms_head(pms_etail[q], pms_ga[q], pms_gb[q], -1, 0);");
  L("  else:");
  L("    pms_paint(pms_line(pms_ga[q], pms_gb[q], pms_gc[q], pms_gd[q]), -1, pms_csig, 1.5, d);");
  L("    ex := pms_gc[q]; ey := pms_gd[q];");
  L("    ux := pms_sign(pms_gc[q] - pms_ga[q]); uy := 0;");
  L("    if ux = 0: uy := pms_sign(pms_gd[q] - pms_gb[q]); fi");
  L("    pms_head(pms_ehead[q], ex, ey, ux, uy); pms_head(pms_etail[q], pms_ga[q], pms_gb[q], -ux, -uy);");
  L("  fi");
  L("  if pms_ecto[q] = 1: pms_paint(pms_circle(ex, ey, 5pms_px), pms_csig, -1, 0, 0); fi");
  L("  if pms_ecfrom[q] = 1: pms_paint(pms_circle(pms_ga[q], pms_gb[q], 5pms_px), pms_csig, -1, 0, 0); fi");
  L('  if pms_etext[q] <> "": pms_put(pms_epic[q], pms_gtx[q], pms_gty[q], pms_csigtext); fi');
  L('  if pms_enum[q] <> "":');
  L("    pms_paint(pms_circle(pms_ga[q], pms_gb[q], 9pms_px), pms_cnum, -1, 0, 0);");
  L("    p := textext(pms_enum[q]) scaled (12/16);");
  L("    pms_put(p, pms_ga[q], pms_gb[q], pms_cnumtext);");
  L("  fi");
  L("  endgroup");
  L("enddef;");
  L("def pms_drawnote(expr q) =");
  L("  pms_paint(pms_rect(pms_ga[q], pms_gb[q], pms_gc[q], pms_gd[q]), pms_cnfill, pms_cnline, 1, 0);");
  L("  pms_put(pms_epic[q], pms_gtx[q], pms_gty[q], pms_cntext);");
  L("enddef;");
  L("def pms_drawframe(expr f) =");
  L("  pms_paint(pms_rect(pms_fxa[f], pms_fya[f], pms_fxb[f], pms_fyb[f]), -1, pms_clline, 2, 2);");
  L("  pms_paint(pms_up(pms_fxa[f], pms_fya[f]) -- pms_up(pms_fxa[f] + pms_flw[f], pms_fya[f])");
  L("    -- pms_up(pms_fxa[f] + pms_flw[f], pms_fya[f] + pms_flh[f] - 7pms_px)");
  L("    -- pms_up(pms_fxa[f] + pms_flw[f] - 8.4pms_px, pms_fya[f] + pms_flh[f])");
  L("    -- pms_up(pms_fxa[f], pms_fya[f] + pms_flh[f]) -- cycle, pms_clfill, pms_clline, 1, 0);");
  L("  pms_put(pms_flpic[f], pms_fxa[f] + pms_flw[f] / 2, pms_fya[f] + pms_flh[f] / 2, pms_cltext);");
  L("  if pms_ftw[f] > 0: pms_put(pms_ftpic[f], pms_ftx[f], pms_fty[f], pms_clooptext); fi");
  L("  for k = 0 upto pms_fns[f] - 1:");
  L("    pms_paint(pms_line(pms_fxa[f], pms_sy[f][k], pms_fxb[f], pms_sy[f][k]), -1, pms_clline, 2, 2);");
  L("    if pms_stw[f][k] > 0:");
  L("      pms_put(pms_spic[f][k], pms_ftx[f], pms_sty[f][k], pms_clooptext);");
  L("    fi");
  L("  endfor");
  L("enddef;");
  L("def pms_drawing =");
  L("  image(");
  L("    for k = 0 upto pms_nb - 1:");
  L("      pms_paint(pms_rect(pms_bxa[k], pms_bya[k], pms_bxb[k], pms_byb[k]), pms_bfill[k], pms_cboxline, 1, 0);");
  L('      if pms_btitle[k] <> "": pms_put(pms_bpic[k], pms_btx[k], pms_bty[k], pms_catext); fi');
  L("    endfor");
  L("    for k = 0 upto pms_nf - 1:");
  L("      if pms_eblock[pms_fr[k]] = 7:");
  L("        pms_paint(pms_rect(pms_fxa[pms_fr[k]], pms_fya[pms_fr[k]], pms_fxb[pms_fr[k]], pms_fyb[pms_fr[k]]),");
  L("          pms_efill[pms_fr[k]], -1, 0, 0);");
  L("      fi");
  L("    endfor");
  L("    for i = 0 upto pms_n - 1:");
  L("      pms_paint(pms_line(pms_x[i], pms_lifea[i], pms_x[i], pms_lifeb[i]), -1, pms_clife, 0.5, 0);");
  L("    endfor");
  L("    for k = 0 upto pms_nbar - 1:");
  L("      pms_paint(pms_rect(pms_rxa[k], pms_rya[k], pms_rxb[k], pms_ryb[k]), pms_cbfill, pms_cbline, 1, 0);");
  L("    endfor");
  L("    for k = 0 upto pms_nf - 1:");
  L("      if pms_eblock[pms_fr[k]] <> 7: pms_drawframe(pms_fr[k]); fi");
  L("    endfor");
  L("    for q = 0 upto pms_ne - 1:");
  L("      if pms_ek[q] = 0: pms_drawmsg(q); elseif pms_ek[q] = 1: pms_drawnote(q); fi");
  L("    endfor");
  L("    for i = 0 upto pms_n - 1:");
  L("      pms_participant(i, pms_top[i]);");
  L("      if pms_footer[i] = 1: pms_participant(i, pms_foot[i]); fi");
  L("      if pms_ades[i] >= 0:");
  L("        pms_paint(pms_line(pms_x[i] - 9pms_px, pms_lifeb[i] - 9pms_px, pms_x[i] + 9pms_px,");
  L("          pms_lifeb[i] + 9pms_px), -1, pms_caline, 2, 0);");
  L("        pms_paint(pms_line(pms_x[i] - 9pms_px, pms_lifeb[i] + 9pms_px, pms_x[i] + 9pms_px,");
  L("          pms_lifeb[i] - 9pms_px), -1, pms_caline, 2, 0);");
  L("      fi");
  L("    endfor");
  L("  )");
  L("enddef;");
  L("def pms_drawtitle(suffix p) =");
  L("  begingroup save t; picture t;");
  L("  t := pms_text(pms_title) scaled (18/16);");
  L("  t := t shifted ((xpart llcorner p + xpart urcorner p) / 2");
  L("    - (xpart llcorner t + xpart urcorner t) / 2, ypart urcorner p + 25pms_px);");
  L("  p := image(draw p; draw t withcolor pms_col(pms_ctitle));");
  L("  endgroup");
  L("enddef;");
  L("def pms_end =");
  L("  begingroup save p; picture p;");
  L("  pms_layout;");
  L("  p := pms_drawing;");
  L('  if pms_title <> "": pms_drawtitle(p); fi');
  L("  if (pms_maxw > 0) and (pms_picw(p) > pms_maxw): p := p scaled (pms_maxw / pms_picw(p)); fi");
  L("  draw p;");
  L("  endgroup");
  L("enddef;");
END Write;

END PmSeqMacros.
