MODULE PmMpMacros;
(* PmMpMacros: the MetaPost macros of mp/pomermaid.mp, without their comments,
   for the MetaPost writer. Made from mp/pomermaid.mp by tools/mp2mod: do not
   edit it; edit mp/pomermaid.mp. *)

IMPORT PmIO;

PROCEDURE L(s: ARRAY OF CHAR);
BEGIN
  PmIO.WriteString(s); PmIO.WriteLn
END L;

(* Writes the macros *)
PROCEDURE Write*;
BEGIN
  L("numeric pm_dir, pm_size, pm_maxw, pm_nn, pm_ne, pm_nr, pm_em, pm_px;");
  L("numeric pm_kind[], pm_rank[], pm_order[], pm_tx[], pm_shape[], pm_ofedge[];");
  L("numeric pm_w[], pm_h[], pm_fw[], pm_fh[], pm_x[], pm_y[], pm_tw[], pm_th[];");
  L("numeric pm_fill[], pm_line[], pm_text[], pm_lw[], pm_dash[];");
  L("numeric pm_layer[][], pm_len[], pm_rankh[];");
  L("numeric pm_ef[], pm_et[], pm_erev[], pm_elab[], pm_ehead[], pm_etail[], pm_evis[];");
  L("numeric pm_eline[], pm_etext[], pm_ewd[], pm_edash[], pm_echain[][], pm_enc[];");
  L("numeric pm_elw[], pm_elh[], pm_elx[], pm_ely[];");
  L("numeric pm_nc, pm_cparent[], pm_cmin[], pm_cmax[], pm_cdepth[], pm_ctw[], pm_cth[];");
  L("numeric pm_ctop[], pm_cbot[], pm_cextra[], pm_cx[], pm_cy[], pm_cw[], pm_ch[];");
  L("numeric pm_ctx[], pm_cty[], pm_cleft[][], pm_cright[][], pm_ranky[];");
  L("numeric pm_efc[], pm_etc[];");
  L("string pm_ctitle[]; picture pm_cpic[];");
  L("pair pm_p[][]; numeric pm_np[];");
  L("color pm_c[];");
  L("string pm_lab[], pm_elabel[];");
  L("picture pm_pic[];");
  L("pm_rect := 0; pm_round := 1; pm_stadium := 2; pm_subroutine := 3;");
  L("pm_cylinder := 4; pm_circle := 5; pm_asymmetric := 6; pm_diamond := 7;");
  L("pm_hexagon := 8; pm_leanright := 9; pm_leanleft := 10; pm_trapezoid := 11;");
  L("pm_invtrapezoid := 12; pm_doublecircle := 13;");
  L("pm_datastore := 14; pm_folder := 15; pm_bucket := 16; pm_console := 17; pm_browser := 18;");
  L("pm_person := 19; pm_bang := 20; pm_cloud := 21; pm_textshape := 22; pm_notchrect := 23;");
  L("pm_linrect := 24; pm_smcircle := 25; pm_frcircle := 26; pm_fork := 27; pm_hourglass := 28;");
  L("pm_brace := 29; pm_bracer := 30; pm_braces := 31; pm_bolt := 32; pm_doc := 33; pm_delay := 34;");
  L("pm_hcylinder := 35; pm_lincylinder := 36; pm_curvtrap := 37; pm_divrect := 38;");
  L("pm_triangle := 39; pm_winpane := 40; pm_fcircle := 41; pm_notchpent := 42;");
  L("pm_fliptriangle := 43; pm_slrect := 44; pm_docs := 45; pm_strect := 46; pm_bowrect := 47;");
  L("pm_crosscircle := 48; pm_tagdoc := 49; pm_tagrect := 50; pm_flag := 51; pm_lindoc := 52;");
  L("pm_choice := 53; pm_statebox := 54; pm_statedesc := 55;");
  L("pm_sub := 56; pm_collapsed := 57;");
  L("pm_endnone := 0; pm_endarrow := 1; pm_endcircle := 2; pm_endcross := 3;");
  L("numeric pm_ranksep, pm_subof[]; picture pm_subpic[];");
  L("def pm_begin(expr d, s, mw, nn, ne, nr, nc) =");
  L("  pm_dir := d; pm_size := s; pm_maxw := mw; pm_nn := nn; pm_ne := ne; pm_nr := nr;");
  L("  pm_nc := nc; pm_ranksep := 25;");
  L("  for r = 0 upto nr - 1: pm_len[r] := 0; endfor");
  L("  for j = 0 upto ne - 1: pm_ecurve[j] := 0; endfor");
  L("enddef;");
  L("def pm_subnode(expr v, k) = pm_subof[v] := k; enddef;");
  L("def pm_cluster(expr c, p, mn, mx, lab) =");
  L("  pm_cparent[c] := p; pm_cmin[c] := mn; pm_cmax[c] := mx; pm_ctitle[c] := lab;");
  L("enddef;");
  L("numeric pm_cin[];");
  L("def pm_cstyle(expr c, f, l, t, w, d) =");
  L("  pm_style(pm_nn + c, f, l, t, w, d); pm_cin[c] := -1;");
  L("enddef;");
  L("def pm_cinner(expr c, i) = pm_cin[c] := i; enddef;");
  L("numeric pm_nl[];");
  L("def pm_lines(expr v, n) = pm_nl[v] := n; enddef;");
  L("def pm_colour(expr c, r, g, b) =");
  L("  pm_c[c] := (r, g, b);");
  L("enddef;");
  L("def pm_node(expr v, k, r, o, x, sh, e, lab) =");
  L("  pm_kind[v] := k; pm_rank[v] := r; pm_order[v] := o; pm_tx[v] := x;");
  L("  pm_shape[v] := sh; pm_ofedge[v] := e; pm_lab[v] := lab;");
  L("  if k = 6:");
  L("    pm_x[v] := 0; pm_y[v] := 0;");
  L("  else:");
  L("    pm_layer[r][o] := v;");
  L("    if o + 1 > pm_len[r]: pm_len[r] := o + 1; fi");
  L("    if k = 4: pm_cleft[e][r] := v; elseif k = 5: pm_cright[e][r] := v; fi");
  L("  fi");
  L("enddef;");
  L("def pm_style(expr v, f, l, t, w, d) =");
  L("  pm_fill[v] := f; pm_line[v] := l; pm_text[v] := t; pm_lw[v] := w; pm_dash[v] := d;");
  L("enddef;");
  L("def pm_edge(expr j, f, t, fc, tc, rv, ln, hd, tl, vis, l, tx, w, d, lab)(text chain) =");
  L("  pm_ef[j] := f; pm_et[j] := t; pm_efc[j] := fc; pm_etc[j] := tc;");
  L("  pm_erev[j] := rv; pm_elab[j] := ln;");
  L("  pm_ehead[j] := hd; pm_etail[j] := tl; pm_evis[j] := vis;");
  L("  pm_eline[j] := l; pm_etext[j] := tx; pm_ewd[j] := w; pm_edash[j] := d;");
  L("  pm_elabel[j] := lab; pm_enc[j] := 0;");
  L("  for c = chain: pm_echain[j][pm_enc[j]] := c; pm_enc[j] := pm_enc[j] + 1; endfor");
  L("enddef;");
  L("vardef pm_textext(expr s) =");
  L('  textext("\framed[frame=off,offset=0pt,align=middle]{" & s & "}")');
  L("enddef;");
  L("def pm_shapesize(expr v) =");
  L("  begingroup save p, r, ry, tw, th, sh, w, h;");
  L("  tw := pm_tw[v]; th := pm_th[v]; sh := pm_shape[v];");
  L("  p := pm_em * 15 / 16;");
  L("  w := tw + 2p; h := th + 2p;");
  L("  if sh = pm_stadium: w := tw + h / 2 + 2p;");
  L("  elseif sh = pm_subroutine: w := w + pm_em;");
  L("  elseif sh = pm_cylinder: ry := w / 2 / (2.5 + w / 50); h := h + 2ry;");
  L("  elseif (sh = pm_circle) or (sh = pm_doublecircle):");
  L("    r := max(tw, th) / 2 + p;");
  L("    if sh = pm_doublecircle: r := r + pm_em * 5 / 16; fi");
  L("    w := 2r; h := w;");
  L("  elseif (sh = pm_asymmetric) or (sh = pm_hexagon): w := w + h / 2;");
  L("  elseif sh = pm_diamond: w := w + h; h := w;");
  L("  elseif (sh >= pm_leanright) and (sh <= pm_invtrapezoid): w := w + 2h / 3;");
  L("  elseif sh = pm_collapsed: w := max(tw + 16pm_px, 80pm_px); h := th + 44pm_px;");
  L("  elseif sh >= pm_datastore: pm_xsize;");
  L("  fi");
  L("  pm_w[v] := w; pm_h[v] := h;");
  L("  endgroup");
  L("enddef;");
  L("vardef pm_clamp(expr a, lo, hi) = max(lo, min(a, hi)) enddef;");
  L("def pm_xsize =");
  L("  begingroup save q, r, t, u; u := pm_px;");
  L("  if sh = pm_datastore: w := tw + 4p;");
  L("  elseif sh = pm_folder: q := 12u; w := max(tw + 2q, 90u); h := th + 2q + pm_clamp(0.16w, 8u, 14u);");
  L("  elseif sh = pm_bucket: q := 12u; w := max(tw + 2q, 80u); h := th + 2q + pm_clamp(0.08w, 5u, 12u);");
  L("  elseif sh = pm_console: q := 12u; w := max(tw + 2q, 90u); h := th + 2q + 20u;");
  L("  elseif sh = pm_browser: q := 12u; w := max(tw + 2q, 90u); h := th + 2q + 18u;");
  L("  elseif sh = pm_person:");
  L("    q := 20u; w := max(tw + 2q, 100u); r := pm_clamp(0.23w, 16u, 56u) / 2; h := 1.6r + th + 2q;");
  L("  elseif (sh = pm_bang) or (sh = pm_cloud): w := (tw + p) * 1.77; h := (th + p) * 1.77;");
  L("  elseif sh = pm_textshape: w := tw + p; h := th + p;");
  L("  elseif sh = pm_notchrect: w := tw + p + 12u; h := th + p;");
  L("  elseif (sh = pm_linrect) or (sh = pm_lindoc): w := w + 16u;");
  L("  elseif (sh = pm_smcircle) or (sh = pm_frcircle) or (sh = pm_fcircle): w := 14u; h := w;");
  L("  elseif sh = pm_fork: if pm_dir >= 2: w := 10u; h := 70u; else: w := 70u; h := 10u; fi");
  L("  elseif sh = pm_hourglass: w := 30u; h := w;");
  L("  elseif (sh >= pm_brace) and (sh <= pm_braces):");
  L("    h := th + p; r := max(5u, 0.1h);");
  L("    if sh = pm_braces: w := tw + p + 4r; else: w := tw + p + 2r; fi");
  L("  elseif sh = pm_bolt: w := 35u; h := 70u;");
  L("  elseif (sh = pm_doc) or (sh = pm_tagdoc): h := h + h / 8;");
  L("  elseif sh = pm_delay: w := w + h / 2;");
  L("  elseif sh = pm_hcylinder: w := w + 3 * (h / 2 / (2.5 + h / 50));");
  L("  elseif sh = pm_lincylinder: h := h + w / (2.5 + w / 50);");
  L("  elseif sh = pm_curvtrap: w := w + h;");
  L("  elseif sh = pm_divrect: h := 1.2h;");
  L("  elseif (sh = pm_triangle) or (sh = pm_fliptriangle):");
  L("    t := th + p; w := tw + p + 1.155t; h := max(0.866w, 2t);");
  L("  elseif sh = pm_winpane: w := w + 5u; h := h + 5u;");
  L("  elseif sh = pm_slrect: h := 1.5h;");
  L("  elseif sh = pm_docs: w := w + 10u; h := h + h / 8 + 10u;");
  L("  elseif sh = pm_strect: w := w + 10u; h := h + 10u;");
  L("  elseif sh = pm_bowrect: w := w + 2 * (h / 2 / (2.5 + h / 50));");
  L("  elseif sh = pm_crosscircle: w := 60u; h := w;");
  L("  elseif sh = pm_flag: h := h + h / 4;");
  L("  elseif sh = pm_choice: w := 28u; h := w;");
  L("  elseif (sh = pm_statebox) or (sh = pm_statedesc): w := tw + 16u; h := th + 16u;");
  L("  fi");
  L("  endgroup");
  L("enddef;");
  L("def pm_sizes =");
  L("  for v = 0 upto pm_nn - 1:");
  L("    pm_tw[v] := 0; pm_th[v] := 0;");
  L("    if (pm_kind[v] = 0) and (pm_shape[v] = pm_sub):");
  L("      pm_pic[v] := pm_subpic[pm_subof[v]];");
  L("      pm_w[v] := xpart urcorner pm_pic[v] - xpart llcorner pm_pic[v];");
  L("      pm_h[v] := ypart urcorner pm_pic[v] - ypart llcorner pm_pic[v];");
  L("    elseif pm_kind[v] = 0:");
  L("      pm_pic[v] := pm_textext(pm_lab[v]);");
  L("      pm_tw[v] := xpart urcorner pm_pic[v] - xpart llcorner pm_pic[v];");
  L("      pm_th[v] := ypart urcorner pm_pic[v] - ypart llcorner pm_pic[v];");
  L("      pm_shapesize(v);");
  L('    elseif (if (pm_kind[v] = 2) or (pm_kind[v] = 3): pm_elabel[pm_ofedge[v]] else: "" fi) <> "":');
  L("      pm_pic[v] := pm_textext(pm_elabel[pm_ofedge[v]]);");
  L("      pm_tw[v] := xpart urcorner pm_pic[v] - xpart llcorner pm_pic[v];");
  L("      pm_th[v] := ypart urcorner pm_pic[v] - ypart llcorner pm_pic[v];");
  L("      pm_w[v] := pm_tw[v] + pm_em / 2; pm_h[v] := pm_th[v];");
  L("    else:");
  L("      pm_w[v] := 0; pm_h[v] := 0;");
  L("    fi");
  L("    if pm_dir >= 2: pm_fw[v] := pm_h[v]; pm_fh[v] := pm_w[v];");
  L("    else: pm_fw[v] := pm_w[v]; pm_fh[v] := pm_h[v]; fi");
  L("  endfor");
  L("  for c = 0 upto pm_nc - 1:");
  L("    pm_cpic[c] := pm_textext(pm_ctitle[c]);");
  L("    pm_ctw[c] := xpart urcorner pm_cpic[c] - xpart llcorner pm_cpic[c];");
  L("    pm_cth[c] := ypart urcorner pm_cpic[c] - ypart llcorner pm_cpic[c];");
  L("  endfor");
  L("enddef;");
  L("def pm_depths =");
  L("  for c = 0 upto pm_nc - 1:");
  L("    begingroup save p; pm_cdepth[c] := 0; p := pm_cparent[c];");
  L("    forever:");
  L("      exitif p < 0;");
  L("      pm_cdepth[c] := pm_cdepth[c] + 1; p := pm_cparent[p];");
  L("    endfor");
  L("    endgroup;");
  L("  endfor");
  L("enddef;");
  L("def pm_positiony =");
  L("  begingroup save y, m, pad, maxd, pass, again, t, cp, above, below, topx, botx,");
  L("    subtop, subbot;");
  L("  numeric above[], below[], topx[], botx[], subtop[], subbot[]; boolean again;");
  L("  pad := 15pm_px;");
  L("  for r = 0 upto pm_nr - 1:");
  L("    m := 0;");
  L("    for i = 0 upto pm_len[r] - 1: m := max(m, pm_fh[pm_layer[r][i]]); endfor");
  L("    pm_rankh[r] := m;");
  L("  endfor");
  L("  maxd := 0;");
  L("  for c = 0 upto pm_nc - 1: maxd := max(maxd, pm_cdepth[c]); pm_cextra[c] := 0; endfor");
  L("  pass := 0;");
  L("  forever:");
  L("    for r = 0 upto pm_nr - 1: above[r] := 0; below[r] := 0; endfor");
  L("    for c = 0 upto pm_nc - 1: subtop[c] := 0; subbot[c] := 0; endfor");
  L("    for d = maxd downto 0:");
  L("      for c = 0 upto pm_nc - 1:");
  L("        if (pm_cdepth[c] = d) and (pm_cmin[c] >= 0):");
  L("          if pm_dir = 0: topx[c] := pm_cth[c] + 1.5pad; else: topx[c] := pad; fi");
  L("          if pm_dir = 1: botx[c] := pm_cth[c] + 1.5pad; else: botx[c] := pad; fi");
  L("          topx[c] := topx[c] + subtop[c]; botx[c] := botx[c] + subbot[c] + pm_cextra[c];");
  L("          above[pm_cmin[c]] := max(above[pm_cmin[c]], topx[c]);");
  L("          below[pm_cmax[c]] := max(below[pm_cmax[c]], botx[c]);");
  L("          cp := pm_cparent[c];");
  L("          if cp >= 0:");
  L("            if pm_cmin[c] = pm_cmin[cp]: subtop[cp] := max(subtop[cp], topx[c]); fi");
  L("            if pm_cmax[c] = pm_cmax[cp]: subbot[cp] := max(subbot[cp], botx[c]); fi");
  L("          fi");
  L("        fi");
  L("      endfor");
  L("    endfor");
  L("    y := 0;");
  L("    for r = 0 upto pm_nr - 1:");
  L("      y := y + above[r]; pm_ranky[r] := y; m := pm_rankh[r];");
  L("      for i = 0 upto pm_len[r] - 1: pm_y[pm_layer[r][i]] := y + m / 2; endfor");
  L("      y := y + m + below[r] + pm_ranksep * pm_px;");
  L("    endfor");
  L("    again := false;");
  L("    for c = 0 upto pm_nc - 1:");
  L("      if pm_cmin[c] >= 0:");
  L("        pm_ctop[c] := pm_ranky[pm_cmin[c]] - topx[c];");
  L("        pm_cbot[c] := pm_ranky[pm_cmax[c]] + pm_rankh[pm_cmax[c]] + botx[c];");
  L("        if pm_dir >= 2:");
  L("          t := pm_ctw[c] + 2pad - (pm_cbot[c] - pm_ctop[c]);");
  L("          if t > 0.01: pm_cextra[c] := pm_cextra[c] + t; again := true; fi");
  L("        fi");
  L("      fi");
  L("    endfor");
  L("    pass := pass + 1;");
  L("    exitif (not again) or (pass = 3);");
  L("  endfor");
  L("  endgroup");
  L("enddef;");
  L("vardef pm_sep(expr v, u) =");
  L("  save x; x := pm_fw[v] / 2 + pm_fw[u] / 2;");
  L("  if (pm_kind[v] = 4) or (pm_kind[u] = 5):");
  L("    if pm_kind[v] = 4:");
  L("      if pm_dir >= 2: x := x + pm_cth[pm_ofedge[v]] + 22.5pm_px; else: x := x + 15pm_px; fi");
  L("    fi");
  L("    if pm_kind[u] = 5: x := x + 15pm_px; fi");
  L("  else:");
  L("    x := x + (if (pm_kind[v] = 0) or (pm_kind[v] >= 4): 25 else: 10 fi) * pm_px");
  L("      + (if (pm_kind[u] = 0) or (pm_kind[u] >= 4): 25 else: 10 fi) * pm_px;");
  L("  fi");
  L("  x");
  L("enddef;");
  L("def pm_positionx =");
  L("  begingroup save c, t, bs, bsum, bn, nb, k, n, v;");
  L("  numeric c[], t[], bs[], bsum[], bn[];");
  L("  k := pm_em / pm_size;");
  L("  for r = 0 upto pm_nr - 1:");
  L("    n := pm_len[r];");
  L("    if n > 0:");
  L("      c[0] := 0;");
  L("      for i = 1 upto n - 1:");
  L("        c[i] := c[i - 1] + pm_sep(pm_layer[r][i - 1], pm_layer[r][i]);");
  L("      endfor");
  L("      nb := 0;");
  L("      for i = 0 upto n - 1:");
  L("        bs[nb] := i; bsum[nb] := pm_tx[pm_layer[r][i]] * k - c[i]; bn[nb] := 1;");
  L("        nb := nb + 1;");
  L("        forever:");
  L("          exitif nb < 2;");
  L("          exitunless bsum[nb - 2] / bn[nb - 2] > bsum[nb - 1] / bn[nb - 1];");
  L("          bsum[nb - 2] := bsum[nb - 2] + bsum[nb - 1];");
  L("          bn[nb - 2] := bn[nb - 2] + bn[nb - 1];");
  L("          nb := nb - 1;");
  L("        endfor");
  L("      endfor");
  L("      bs[nb] := n;");
  L("      for b = 0 upto nb - 1:");
  L("        for i = bs[b] upto bs[b + 1] - 1:");
  L("          pm_x[pm_layer[r][i]] := bsum[b] / bn[b] + c[i];");
  L("        endfor");
  L("      endfor");
  L("    fi");
  L("  endfor");
  L("  endgroup");
  L("enddef;");
  L("def pm_repair =");
  L("  begingroup save it, changed, m, lx, rx, lo, hi, t, u, v; boolean changed;");
  L("  it := 0;");
  L("  forever:");
  L("    changed := false;");
  L("    for r = 0 upto pm_nr - 1:");
  L("      for i = 1 upto pm_len[r] - 1:");
  L("        u := pm_layer[r][i - 1]; v := pm_layer[r][i];");
  L("        m := pm_x[u] + pm_sep(u, v);");
  L("        if pm_x[v] < m - 0.001: pm_x[v] := m; changed := true; fi");
  L("      endfor");
  L("    endfor");
  L("    for c = 0 upto pm_nc - 1:");
  L("      if pm_cmin[c] >= 0:");
  L("        lx := pm_x[pm_cleft[c][pm_cmin[c]]]; rx := pm_x[pm_cright[c][pm_cmin[c]]];");
  L("        for r = pm_cmin[c] + 1 upto pm_cmax[c]:");
  L("          lx := max(lx, pm_x[pm_cleft[c][r]]); rx := max(rx, pm_x[pm_cright[c][r]]);");
  L("        endfor");
  L("        if pm_dir < 2: m := pm_ctw[c] + 30pm_px; else: m := 0; fi");
  L("        if rx < lx + m - 0.001:");
  L("          lo := rx; hi := lx;");
  L("          for r = pm_cmin[c] upto pm_cmax[c]:");
  L("            for i = pm_order[pm_cleft[c][r]] + 1 upto pm_order[pm_cright[c][r]] - 1:");
  L("              v := pm_layer[r][i];");
  L("              lo := min(lo, pm_x[v] - pm_fw[v] / 2); hi := max(hi, pm_x[v] + pm_fw[v] / 2);");
  L("            endfor");
  L("          endfor");
  L("          t := lx + m / 2 - (lo + hi) / 2;");
  L("          if (hi < lo) or (t < 0): t := 0; fi");
  L("          for r = pm_cmin[c] upto pm_cmax[c]:");
  L("            for i = pm_order[pm_cleft[c][r]] + 1 upto pm_order[pm_cright[c][r]] - 1:");
  L("              v := pm_layer[r][i]; pm_x[v] := pm_x[v] + t;");
  L("            endfor");
  L("          endfor");
  L("          rx := lx + m;");
  L("        fi");
  L("        for r = pm_cmin[c] upto pm_cmax[c]:");
  L("          if pm_x[pm_cleft[c][r]] < lx - 0.001: pm_x[pm_cleft[c][r]] := lx; changed := true; fi");
  L("          if pm_x[pm_cright[c][r]] < rx - 0.001: pm_x[pm_cright[c][r]] := rx; changed := true; fi");
  L("        endfor");
  L("      fi");
  L("    endfor");
  L("    it := it + 1;");
  L("    exitif (not changed) or (it = 200);");
  L("  endfor");
  L("  endgroup");
  L("enddef;");
  L("def pm_boxes =");
  L("  for c = 0 upto pm_nc - 1:");
  L("    if pm_cmin[c] >= 0:");
  L("      begingroup save lx, rx;");
  L("      lx := pm_x[pm_cleft[c][pm_cmin[c]]]; rx := pm_x[pm_cright[c][pm_cmin[c]]];");
  L("      pm_cx[c] := (lx + rx) / 2; pm_cw[c] := rx - lx;");
  L("      pm_cy[c] := (pm_ctop[c] + pm_cbot[c]) / 2; pm_ch[c] := pm_cbot[c] - pm_ctop[c];");
  L("      if pm_dir = 0:");
  L("        pm_ctx[c] := pm_cx[c]; pm_cty[c] := pm_ctop[c] + 7.5pm_px + pm_cth[c] / 2;");
  L("      elseif pm_dir = 1:");
  L("        pm_ctx[c] := pm_cx[c]; pm_cty[c] := pm_cbot[c] - 7.5pm_px - pm_cth[c] / 2;");
  L("      else:");
  L("        pm_ctx[c] := lx + 7.5pm_px + pm_cth[c] / 2; pm_cty[c] := pm_cy[c];");
  L("      fi");
  L("      endgroup;");
  L("    fi");
  L("  endfor");
  L("enddef;");
  L("vardef pm_face(expr v, q) =");
  L("  save dy, hw, hh, x, cx, cy;");
  L("  cx := pm_x[v]; cy := pm_y[v];");
  L("  dy := ypart q - cy; hw := pm_fw[v] / 2; hh := pm_fh[v] / 2;");
  L("  if dy = 0:");
  L("    if xpart q > cx: (cx + hw, cy) else: (cx - hw, cy) fi");
  L("  else:");
  L("    if dy < 0: hh := -hh; fi");
  L("    x := cx + (xpart q - cx) * hh / dy;");
  L("    if x > cx + hw: x := cx + hw; elseif x < cx - hw: x := cx - hw; fi");
  L("    (x, cy + hh)");
  L("  fi");
  L("enddef;");
  L("vardef pm_needband(expr v, f, q) =");
  L("  save hh, y;");
  L("  hh := pm_rankh[pm_rank[v]] / 2;");
  L("  if ypart q > pm_y[v]: y := pm_y[v] + hh; else: y := pm_y[v] - hh; fi");
  L("  pm_band := (xpart f, y);");
  L("  (pm_fh[v] < 2hh - 1) and (abs(ypart q - pm_y[v]) > hh) and (abs(y - ypart f) > 0.5)");
  L("enddef;");
  L("pair pm_band;");
  L("def pm_routes =");
  L("  for j = 0 upto pm_ne - 1:");
  L("    if pm_ef[j] = pm_et[j]:");
  L("      begingroup save n, d, x, y, dx, dy;");
  L("      n := pm_ef[j]; d := pm_echain[j][0];");
  L("      x := pm_x[n] + pm_fw[n] / 2; y := pm_y[n];");
  L("      dx := pm_x[d] - pm_fw[d] / 2 - x; dy := pm_fh[n] / 2;");
  L("      pm_p[j][0] := (x, y - dy / 2);");
  L("      pm_p[j][1] := (x + dx, y - dy);");
  L("      pm_p[j][2] := (x + dx, y + dy);");
  L("      pm_p[j][3] := (x, y + dy / 2);");
  L("      pm_np[j] := 4;");
  L("      endgroup;");
  L("    else:");
  L("      begingroup save u, v, m, q, f, a, b, ba, bb, nc; pair q[], f[], ba, bb;");
  L("      boolean a, b;");
  L("      if pm_erev[j] = 1: u := pm_et[j]; v := pm_ef[j]; else: u := pm_ef[j]; v := pm_et[j]; fi");
  L("      nc := pm_enc[j];");
  L("      for i = 0 upto nc - 1: q[i + 1] := (pm_x[pm_echain[j][i]], pm_y[pm_echain[j][i]]); endfor");
  L("      if nc > 0:");
  L("        q[0] := pm_face(u, q[1]); q[nc + 1] := pm_face(v, q[nc]);");
  L("      else:");
  L("        q[0] := pm_face(u, (pm_x[v], pm_y[v])); q[1] := pm_face(v, (pm_x[u], pm_y[u]));");
  L("      fi");
  L("      m := nc + 2;");
  L("      a := pm_needband(u, q[0], q[1]); ba := pm_band;");
  L("      b := pm_needband(v, q[m - 1], q[m - 2]); bb := pm_band;");
  L("      pm_np[j] := 0;");
  L("      def pm_add(expr z) = pm_p[j][pm_np[j]] := z; pm_np[j] := pm_np[j] + 1; enddef;");
  L("      pm_add(q[0]);");
  L("      if a: pm_add(ba); pm_add(ba); fi");
  L("      for i = 1 upto m - 2: pm_add(q[i]); endfor");
  L("      if b: pm_add(bb); pm_add(bb); fi");
  L("      pm_add(q[m - 1]);");
  L("      if pm_erev[j] = 1:");
  L("        for i = 0 upto pm_np[j] div 2 - 1:");
  L("          f0 := pm_p[j][i]; pm_p[j][i] := pm_p[j][pm_np[j] - 1 - i];");
  L("          pm_p[j][pm_np[j] - 1 - i] := f0;");
  L("        endfor");
  L("      fi");
  L("      endgroup;");
  L("    fi");
  L("    if pm_elab[j] >= 0:");
  L("      pm_elx[j] := pm_x[pm_elab[j]]; pm_ely[j] := pm_y[pm_elab[j]];");
  L("      pm_elw[j] := pm_w[pm_elab[j]]; pm_elh[j] := pm_h[pm_elab[j]];");
  L("    fi");
  L("  endfor");
  L("enddef;");
  L("vardef pm_turn(expr z) =");
  L("  save x, y, t; x := xpart z; y := ypart z;");
  L("  if (pm_dir = 1) or (pm_dir = 3): y := -y; fi");
  L("  if pm_dir >= 2: t := x; x := y; y := t; fi");
  L("  (x, y)");
  L("enddef;");
  L("def pm_turnall =");
  L("  for v = 0 upto pm_nn - 1:");
  L("    pm_xy := pm_turn((pm_x[v], pm_y[v])); pm_x[v] := xpart pm_xy; pm_y[v] := ypart pm_xy;");
  L("  endfor");
  L("  for j = 0 upto pm_ne - 1:");
  L("    for i = 0 upto pm_np[j] - 1: pm_p[j][i] := pm_turn(pm_p[j][i]); endfor");
  L("    if pm_elab[j] >= 0:");
  L("      pm_xy := pm_turn((pm_elx[j], pm_ely[j])); pm_elx[j] := xpart pm_xy; pm_ely[j] := ypart pm_xy;");
  L("    fi");
  L("  endfor");
  L("  for c = 0 upto pm_nc - 1:");
  L("    if pm_cmin[c] >= 0:");
  L("      pm_xy := pm_turn((pm_cx[c], pm_cy[c])); pm_cx[c] := xpart pm_xy; pm_cy[c] := ypart pm_xy;");
  L("      pm_xy := pm_turn((pm_ctx[c], pm_cty[c])); pm_ctx[c] := xpart pm_xy; pm_cty[c] := ypart pm_xy;");
  L("      if pm_dir >= 2: pm_xy := (pm_cw[c], pm_ch[c]); pm_cw[c] := ypart pm_xy; pm_ch[c] := xpart pm_xy; fi");
  L("    fi");
  L("  endfor");
  L("enddef;");
  L("pair pm_xy;");
  L("path pm_cur, pm_so, pm_sp[]; numeric pm_sk[], pm_sn, pm_ck, pm_cn, pm_ox, pm_oy;");
  L("numeric pm_slx, pm_sly; boolean pm_slab; pm_slab := true;");
  L("def pm_B(expr k) = pm_ck := k; pm_cn := 0; enddef;");
  L("def pm_P(expr a, b) =");
  L("  if pm_cn = 0: pm_cur := (pm_ox + a, pm_oy + b);");
  L("  else: pm_cur := pm_cur -- (pm_ox + a, pm_oy + b);");
  L("  fi");
  L("  pm_cn := pm_cn + 1;");
  L("enddef;");
  L("def pm_E =");
  L("  pm_sp[pm_sn] := if pm_ck = 1: pm_cur else: pm_cur -- cycle fi;");
  L("  pm_sk[pm_sn] := pm_ck; pm_sn := pm_sn + 1;");
  L("enddef;");
  L("def pm_O = pm_so := pm_cur -- cycle; enddef;");
  L("def pm_EO = pm_O; pm_E; enddef;");
  L("def pm_arc(expr cx, cy, rx, ry, a, b) =");
  L("  begingroup save n_, t_; n_ := floor(abs(b - a) / 90 * 12) + 1;");
  L("  for k = 0 upto n_:");
  L("    t_ := a + (b - a) * k / n_; pm_P(cx + rx * cosd t_, cy + ry * sind t_);");
  L("  endfor");
  L("  endgroup");
  L("enddef;");
  L("def pm_box(expr xa, ya, xb, yb) = pm_P(xa, ya); pm_P(xb, ya); pm_P(xb, yb); pm_P(xa, yb); enddef;");
  L("def pm_rarcs(expr xa, ya, xb, yb, r) =");
  L("  pm_arc(xb - r, ya + r, r, r, 270, 360); pm_arc(xb - r, yb - r, r, r, 0, 90);");
  L("  pm_arc(xa + r, yb - r, r, r, 90, 180); pm_arc(xa + r, ya + r, r, r, 180, 270);");
  L("enddef;");
  L("vardef pm_wavey(expr xx, w, mid, a, n) = mid + a * sind(360 * n * ((xx + w / 2) / w)) enddef;");
  L("def pm_wave(expr dx, dy, xa, xb, w, mid, a, n) =");
  L("  for k = 0 upto 32:");
  L("    pm_P(dx + xa + (xb - xa) * k / 32, dy + pm_wavey(xa + (xb - xa) * k / 32, w, mid, a, n));");
  L("  endfor");
  L("enddef;");
  L("def pm_document(expr cx, cy, w, h) =");
  L("  pm_P(cx - w / 2, cy - h / 2); pm_P(cx + w / 2, cy - h / 2);");
  L("  pm_wave(cx, cy, w / 2, -w / 2, w, h / 2 - h / 9, h / 9, 0.8);");
  L("enddef;");
  L("def pm_bracepath(expr xa, ya, yb, r) =");
  L("  pm_B(1);");
  L("  pm_arc(xa + 2r, ya + r, r, r, 270, 180); pm_arc(xa, -r, r, r, 0, 90);");
  L("  pm_arc(xa, r, r, r, 270, 360); pm_arc(xa + 2r, yb - r, r, r, 180, 90);");
  L("enddef;");
  L("def pm_shapedraw(expr v) =");
  L("  begingroup save sh, w, h, th, p, u, xl, yt, xr, ybo, q, r, rx, ry, t, a, b, hz, ybd, o;");
  L("  sh := pm_shape[v]; w := pm_w[v]; h := pm_h[v]; th := pm_th[v];");
  L("  p := pm_em * 15 / 16; u := pm_px;");
  L("  pm_ox := pm_x[v]; pm_oy := pm_y[v];");
  L("  xl := -w / 2; yt := -h / 2; xr := w / 2; ybo := h / 2;");
  L("  pm_sn := 0; pm_slab := true; pm_slx := pm_ox; pm_sly := pm_oy;");
  L("  if sh = pm_datastore:");
  L("    pm_B(3); pm_box(xl, yt, xr, ybo); pm_EO;");
  L("    pm_B(1); pm_P(xl, yt); pm_P(xr, yt); pm_E;");
  L("    pm_B(1); pm_P(xl, ybo); pm_P(xr, ybo); pm_E;");
  L("  elseif sh = pm_folder:");
  L("    t := pm_clamp(0.16w, 8u, 14u); a := max(0.38w, 28u);");
  L("    pm_B(0); pm_P(xl, yt); pm_P(xl + a, yt); pm_P(xl + a + t, yt + t); pm_P(xr, yt + t);");
  L("    pm_P(xr, ybo); pm_P(xl, ybo); pm_EO;");
  L("    pm_sly := pm_oy + t / 2;");
  L("  elseif sh = pm_bucket:");
  L("    ry := pm_clamp(0.08w, 5u, 12u);");
  L("    pm_B(0); pm_arc(0, yt + ry, w / 2, ry, 180, 360); pm_P(0.36w, ybo); pm_P(-0.36w, ybo); pm_EO;");
  L("    pm_B(1); pm_arc(0, yt + ry, w / 2, ry, 0, 180); pm_E;");
  L("    pm_sly := pm_oy + ry / 2;");
  L("  elseif sh = pm_console:");
  L("    pm_B(0); pm_rarcs(xl, yt, xr, ybo, 12u); pm_EO;");
  L("    pm_B(1); pm_P(xl + 12u, yt + 8u); pm_P(xl + 17u, yt + 12u); pm_P(xl + 12u, yt + 16u); pm_E;");
  L("    pm_B(1); pm_P(xl + 19u, yt + 16u); pm_P(xl + 26u, yt + 16u); pm_E;");
  L("    pm_sly := pm_oy + 10u;");
  L("  elseif sh = pm_browser:");
  L("    pm_B(0); pm_rarcs(xl, yt, xr, ybo, 12u); pm_EO;");
  L("    pm_B(1); pm_P(xl, yt + 18u); pm_P(xr, yt + 18u); pm_E;");
  L("    for k = 0 upto 2:");
  L("      pm_B(2); pm_arc(xl + (12 + 8 * k) * u, yt + 9u, 2.5u, 2.5u, 0, 360); pm_E;");
  L("    endfor");
  L("    pm_B(1); pm_box(xl + 38u, yt + 4u, xr - 12u, yt + 14u); pm_P(xl + 38u, yt + 4u); pm_E;");
  L("    pm_sly := pm_oy + 9u;");
  L("  elseif sh = pm_person:");
  L("    r := pm_clamp(0.23w, 16u, 56u) / 2; ybd := yt + 1.6r; q := min(0.2w, w / 2 - 0.8r);");
  L("    pm_B(0); pm_arc(xr - q, ybd + q, q, q, 270, 360); pm_P(xr, ybo); pm_P(xl, ybo);");
  L("    pm_arc(xl + q, ybd + q, q, q, 180, 270); pm_arc(0, yt + r, r, r, 143.1301, 396.8699);");
  L("    pm_EO;");
  L("    pm_sly := pm_oy + 0.8r;");
  L("  elseif sh = pm_bang:");
  L("    pm_B(0);");
  L("    for k = 0 upto 31:");
  L("      t := k * 360 / 32 - 90; a := if odd k: 0.82 else: 1 fi;");
  L("      pm_P(a * w / 2 * cosd t, a * h / 2 * sind t);");
  L("    endfor");
  L("    pm_EO;");
  L("  elseif sh = pm_cloud:");
  L("    pm_B(0); b := 0.1 * min(w, h);");
  L("    for k = 0 upto 9:");
  L("      t := k * 36 - 90; a := t + 36;");
  L("      xl := 0.4w * cosd t; yt := 0.4h * sind t; xr := 0.4w * cosd a; ybo := 0.4h * sind a;");
  L("      rx := ybo - yt; ry := xl - xr; q := rx ++ ry; o := min(0.35q, b);");
  L("      rx := rx / q * o; ry := ry / q * o;");
  L("      for m = 0 upto 7:");
  L("        t := sind(22.5 * m);");
  L("        pm_P(xl + (xr - xl) * m / 8 + rx * t, yt + (ybo - yt) * m / 8 + ry * t);");
  L("      endfor");
  L("    endfor");
  L("    pm_EO;");
  L("  elseif sh = pm_textshape: pm_B(0); pm_box(xl, yt, xr, ybo); pm_O;");
  L("  elseif sh = pm_notchrect:");
  L("    pm_B(0); pm_P(xl + 12u, yt); pm_P(xr, yt); pm_P(xr, ybo); pm_P(xl, ybo); pm_P(xl, yt + 12u);");
  L("    pm_EO;");
  L("  elseif sh = pm_linrect:");
  L("    pm_B(0); pm_box(xl, yt, xr, ybo); pm_EO;");
  L("    pm_B(1); pm_P(xl + 8u, yt); pm_P(xl + 8u, ybo); pm_E;");
  L("    pm_slx := pm_ox + 4u;");
  L("  elseif (sh = pm_smcircle) or (sh = pm_fcircle):");
  L("    pm_B(2); pm_arc(0, 0, w / 2, w / 2, 0, 360); pm_EO; pm_slab := false;");
  L("  elseif sh = pm_frcircle:");
  L("    pm_B(0); pm_arc(0, 0, w / 2, w / 2, 0, 360); pm_EO;");
  L("    pm_B(2); pm_arc(0, 0, 2.5u, 2.5u, 0, 360); pm_E; pm_slab := false;");
  L("  elseif sh = pm_fork: pm_B(2); pm_box(xl, yt, xr, ybo); pm_EO; pm_slab := false;");
  L("  elseif sh = pm_hourglass:");
  L("    pm_B(0); pm_P(xl, yt); pm_P(xr, yt); pm_P(xl, ybo); pm_P(xr, ybo); pm_EO; pm_slab := false;");
  L("  elseif (sh >= pm_brace) and (sh <= pm_braces):");
  L("    pm_B(0); pm_box(xl, yt, xr, ybo); pm_O;");
  L("    r := max(5u, 0.1h);");
  L("    if sh <> pm_bracer: pm_bracepath(xl, yt, ybo, r); pm_E; fi");
  L("    if sh <> pm_brace:");
  L("      pm_bracepath(xl, yt, ybo, r);");
  L("      pm_cur := pm_cur reflectedabout((pm_ox, 0), (pm_ox, 1)); pm_E;");
  L("    fi");
  L("    if sh = pm_brace: pm_slx := pm_ox + r; elseif sh = pm_bracer: pm_slx := pm_ox - r; fi");
  L("  elseif sh = pm_bolt:");
  L("    a := w / 35; b := h / 70;");
  L("    pm_B(0); pm_P(17.5a, -35b); pm_P(-17.5a, 3.5b); pm_P(3.5a, 3.5b);");
  L("    pm_P(-17.5a, 35b); pm_P(17.5a, -3.5b); pm_P(-3.5a, -3.5b); pm_EO;");
  L("    pm_slab := false;");
  L("  elseif (sh = pm_doc) or (sh = pm_tagdoc):");
  L("    pm_B(0); pm_document(0, 0, w, h); pm_EO;");
  L("    hz := h * 8 / 9; a := h / 9;");
  L("    if sh = pm_tagdoc:");
  L("      t := 0.2hz;");
  L("      pm_B(1); pm_P(xr - t, pm_wavey(xr - t, w, ybo - a, a, 0.8));");
  L("      pm_P(xr, pm_wavey(xr, w, ybo - a, a, 0.8) - t); pm_E;");
  L("    fi");
  L("    pm_sly := pm_oy - a / 2;");
  L("  elseif sh = pm_delay:");
  L("    pm_B(0); pm_P(xl, yt); pm_arc(xr - h / 2, 0, h / 2, h / 2, 270, 450); pm_P(xl, ybo); pm_EO;");
  L("    pm_slx := pm_ox - h / 4;");
  L("  elseif sh = pm_hcylinder:");
  L("    rx := h / 2 / (2.5 + h / 50);");
  L("    pm_B(0); pm_arc(xr - rx, 0, rx, h / 2, 270, 450); pm_arc(xl + rx, 0, rx, h / 2, 90, 270);");
  L("    pm_EO;");
  L("    pm_B(1); pm_arc(xr - rx, 0, rx, h / 2, 90, 270); pm_E;");
  L("    pm_slx := pm_ox - rx;");
  L("  elseif sh = pm_lincylinder:");
  L("    ry := w / 2 / (2.5 + w / 50);");
  L("    pm_B(0); pm_arc(0, yt + ry, w / 2, ry, 180, 360); pm_arc(0, ybo - ry, w / 2, ry, 0, 180);");
  L("    pm_EO;");
  L("    pm_B(1); pm_arc(0, yt + ry, w / 2, ry, 0, 180); pm_E;");
  L("    pm_B(1); pm_arc(0, yt + ry + 0.1h, w / 2, ry, 0, 180); pm_E;");
  L("    pm_sly := pm_oy + ry;");
  L("  elseif sh = pm_curvtrap:");
  L("    pm_B(0); pm_P(xl, 0); pm_P(xl + h / 2, yt); pm_arc(xr - h / 2, 0, h / 2, h / 2, 270, 450);");
  L("    pm_P(xl + h / 2, ybo); pm_EO;");
  L("  elseif sh = pm_divrect:");
  L("    hz := h / 1.2;");
  L("    pm_B(0); pm_box(xl, yt, xr, ybo); pm_EO;");
  L("    pm_B(1); pm_P(xl, yt + 0.2hz); pm_P(xr, yt + 0.2hz); pm_E;");
  L("    pm_sly := pm_oy + 0.1hz;");
  L("  elseif sh = pm_triangle:");
  L("    pm_B(0); pm_P(0, yt); pm_P(xr, ybo); pm_P(xl, ybo); pm_EO;");
  L("    pm_sly := pm_oy + ybo - (th + p) / 2;");
  L("  elseif sh = pm_fliptriangle:");
  L("    pm_B(0); pm_P(xl, yt); pm_P(xr, yt); pm_P(0, ybo); pm_EO;");
  L("    pm_sly := pm_oy + yt + (th + p) / 2;");
  L("  elseif sh = pm_winpane:");
  L("    pm_B(0); pm_box(xl, yt, xr, ybo); pm_EO;");
  L("    pm_B(1); pm_P(xl + 5u, yt); pm_P(xl + 5u, ybo); pm_E;");
  L("    pm_B(1); pm_P(xl, yt + 5u); pm_P(xr, yt + 5u); pm_E;");
  L("    pm_slx := pm_ox + 2.5u; pm_sly := pm_oy + 2.5u;");
  L("  elseif sh = pm_notchpent:");
  L("    pm_B(0); pm_P(-0.4w, yt); pm_P(0.4w, yt); pm_P(xr, -0.3h); pm_P(xr, ybo); pm_P(xl, ybo);");
  L("    pm_P(xl, -0.3h); pm_EO;");
  L("  elseif sh = pm_slrect:");
  L("    hz := h / 1.5;");
  L("    pm_B(0); pm_P(xl, yt + hz / 2); pm_P(xr, yt); pm_P(xr, ybo); pm_P(xl, ybo); pm_EO;");
  L("    pm_sly := pm_oy + hz / 4;");
  L("  elseif sh = pm_docs:");
  L("    o := 5u;");
  L("    for k = 1 step -1 until -1:");
  L("      pm_B(0); pm_document(k * o, -k * o, w - 2o, h - 2o); pm_E;");
  L("    endfor");
  L("    pm_B(0); pm_box(xl, yt, xr, ybo); pm_O;");
  L("    pm_slx := pm_ox - o; pm_sly := pm_oy + o - (h - 2o) / 18;");
  L("  elseif sh = pm_strect:");
  L("    o := 5u;");
  L("    for k = 1 step -1 until -1:");
  L("      pm_B(0); pm_box(xl + o + k * o, yt + o - k * o, xr - o + k * o, ybo - o - k * o); pm_E;");
  L("    endfor");
  L("    pm_B(0);");
  L("    pm_P(xl + 2o, yt); pm_P(xr, yt); pm_P(xr, ybo - 2o); pm_P(xr - o, ybo - 2o);");
  L("    pm_P(xr - o, ybo - o); pm_P(xr - 2o, ybo - o); pm_P(xr - 2o, ybo); pm_P(xl, ybo);");
  L("    pm_P(xl, yt + 2o); pm_P(xl + o, yt + 2o); pm_P(xl + o, yt + o); pm_P(xl + 2o, yt + o);");
  L("    pm_O;");
  L("    pm_slx := pm_ox - o; pm_sly := pm_oy + o;");
  L("  elseif sh = pm_bowrect:");
  L("    rx := h / 2 / (2.5 + h / 50);");
  L("    pm_B(0); pm_arc(xr, 0, rx, h / 2, 270, 90); pm_arc(xl + rx, 0, rx, h / 2, 90, 270); pm_EO;");
  L("  elseif sh = pm_crosscircle:");
  L("    r := w / 2; a := r * 0.7071;");
  L("    pm_B(0); pm_arc(0, 0, r, r, 0, 360); pm_EO;");
  L("    pm_B(1); pm_P(-a, -a); pm_P(a, a); pm_E;");
  L("    pm_B(1); pm_P(-a, a); pm_P(a, -a); pm_E;");
  L("    pm_slab := false;");
  L("  elseif sh = pm_tagrect:");
  L("    t := 0.2h;");
  L("    pm_B(0); pm_box(xl, yt, xr, ybo); pm_EO;");
  L("    pm_B(1); pm_P(xr - t, ybo); pm_P(xr, ybo - t); pm_E;");
  L("  elseif sh = pm_flag:");
  L("    a := h / 10;");
  L("    pm_B(0); pm_wave(0, 0, xl, xr, w, yt + a, a, 1); pm_wave(0, 0, xr, xl, w, ybo - a, a, 1);");
  L("    pm_EO;");
  L("  elseif sh = pm_lindoc:");
  L("    a := h / 9;");
  L("    pm_B(0); pm_document(0, 0, w, h); pm_EO;");
  L("    pm_B(1); pm_P(xl + 8u, yt); pm_P(xl + 8u, pm_wavey(xl + 8u, w, ybo - a, a, 0.8)); pm_E;");
  L("    pm_slx := pm_ox + 4u; pm_sly := pm_oy - a / 2;");
  L("  elseif sh = pm_choice:");
  L("    pm_B(0); pm_P(0, yt); pm_P(xr, 0); pm_P(0, ybo); pm_P(xl, 0); pm_EO; pm_slab := false;");
  L("  elseif sh = pm_statebox: pm_B(0); pm_rarcs(xl, yt, xr, ybo, 5u); pm_EO;");
  L("  elseif sh = pm_statedesc:");
  L("    pm_B(0); pm_box(xl, yt, xr, ybo); pm_EO;");
  L("    t := -th / 2 + th / pm_nl[v];");
  L("    pm_B(1); pm_P(xl, t); pm_P(xr, t); pm_E;");
  L("  else: pm_B(0); pm_box(xl, yt, xr, ybo); pm_EO;");
  L("  fi");
  L("  endgroup");
  L("enddef;");
  L("def pm_drawpart(expr o, k, v) =");
  L("  if k = 0: pm_paint(o, v, true);");
  L("  elseif k = 1: pm_paint(o, v, false);");
  L("  elseif k = 2:");
  L("    begingroup save c, w; w := pm_lw[v] * pm_em / pm_size;");
  L("    c := if pm_line[v] >= 0: pm_line[v] else: pm_fill[v] fi;");
  L("    if c >= 0:");
  L("      fill o withcolor pm_c[c]; draw o withpen pencircle scaled w withcolor pm_c[c];");
  L("    fi");
  L("    endgroup;");
  L("  elseif pm_fill[v] >= 0: fill o withcolor pm_c[pm_fill[v]];");
  L("  fi");
  L("enddef;");
  L("vardef pm_outline(expr v) =");
  L("  save xl, top, bot, m, cx, cy, w, h, sh;");
  L("  cx := pm_x[v]; cy := pm_y[v]; w := pm_w[v]; h := pm_h[v]; sh := pm_shape[v];");
  L("  xl := cx - w / 2; top := cy - h / 2; bot := cy + h / 2;");
  L("  if sh = pm_diamond: (cx, top) -- (xl + w, cy) -- (cx, bot) -- (xl, cy) -- cycle");
  L("  elseif sh = pm_hexagon: m := h / 4;");
  L("    (xl + m, top) -- (xl + w - m, top) -- (xl + w, cy) -- (xl + w - m, bot)");
  L("      -- (xl + m, bot) -- (xl, cy) -- cycle");
  L("  elseif sh = pm_leanright:");
  L("    (xl, bot) -- (xl + w - h / 2, bot) -- (xl + w, top) -- (xl + h / 2, top) -- cycle");
  L("  elseif sh = pm_leanleft:");
  L("    (xl + h / 2, bot) -- (xl + w, bot) -- (xl + w - h / 2, top) -- (xl, top) -- cycle");
  L("  elseif sh = pm_trapezoid:");
  L("    (xl, bot) -- (xl + w, bot) -- (xl + w - h / 2, top) -- (xl + h / 2, top) -- cycle");
  L("  elseif sh = pm_invtrapezoid:");
  L("    (xl, top) -- (xl + w, top) -- (xl + w - h / 2, bot) -- (xl + h / 2, bot) -- cycle");
  L("  elseif sh = pm_asymmetric:");
  L("    (xl, top) -- (xl + w, top) -- (xl + w, bot) -- (xl, bot) -- (xl + h / 2, cy) -- cycle");
  L("  elseif (sh = pm_circle) or (sh = pm_doublecircle): fullcircle scaled w shifted (cx, cy)");
  L("  elseif sh >= pm_sub: (xl, top) -- (xl + w, top) -- (xl + w, bot) -- (xl, bot) -- cycle");
  L("  elseif sh >= pm_datastore: pm_shapedraw(v); pm_so");
  L("  else: (xl, top) -- (xl + w, top) -- (xl + w, bot) -- (xl, bot) -- cycle");
  L("  fi");
  L("enddef;");
  L("vardef pm_clipped(expr v) =");
  L("  (pm_shape[v] >= pm_circle) and (pm_shape[v] < pm_sub)");
  L("enddef;");
  L("vardef pm_firsthit(expr a, b, o) =");
  L("  save t, r, e; pair r, e;");
  L("  pm_hit := false; r := a;");
  L("  t := xpart ((a -- b) intersectiontimes o);");
  L("  if t >= 0:");
  L("    pm_hit := true; r := point t of (a -- b);");
  L("    forever:");
  L("      exitif abs(r - a) < 0.01;");
  L("      e := r - 0.01 * unitvector(r - a);");
  L("      t := xpart ((a -- e) intersectiontimes o);");
  L("      exitif t < 0;");
  L("      r := point t of (a -- e);");
  L("    endfor");
  L("  fi");
  L("  r");
  L("enddef;");
  L("boolean pm_hit;");
  L("vardef pm_clip(expr v, q, p) =");
  L("  save o, d, c, r, h; path o; pair d, c, r, h;");
  L("  r := q;");
  L("  if pm_clipped(v):");
  L("    o := pm_outline(v); c := (pm_x[v], pm_y[v]);");
  L("    pm_hit := false;");
  L("    if abs(q - p) > 0:");
  L("      d := unitvector(q - p) * (pm_w[v] + pm_h[v]);");
  L("      h := pm_firsthit(p, q + d, o);");
  L("      if pm_hit: r := h; fi");
  L("    fi");
  L("    if (not pm_hit) and (abs(c - q) > 0):");
  L("      h := pm_firsthit(q, c, o);");
  L("      if pm_hit: r := h; fi");
  L("    fi");
  L("  fi");
  L("  r");
  L("enddef;");
  L("vardef pm_inbox(expr c, z) =");
  L("  (abs(xpart z - pm_cx[c]) < pm_cw[c] / 2) and (abs(ypart z - pm_cy[c]) < pm_ch[c] / 2)");
  L("enddef;");
  L("def pm_cutbox(expr j, c, start) =");
  L("  begingroup save n, i, a, b, m, q; pair a, b, m, q[];");
  L("  n := pm_np[j];");
  L("  for k = 0 upto n - 1:");
  L("    if start: q[k] := pm_p[j][k]; else: q[k] := pm_p[j][n - 1 - k]; fi");
  L("  endfor");
  L("  i := 0;");
  L("  forever:");
  L("    exitif i = n;");
  L("    exitunless pm_inbox(c, q[i]);");
  L("    i := i + 1;");
  L("  endfor");
  L("  if (i > 0) and (i < n):");
  L("    a := q[i - 1]; b := q[i];");
  L("    for k = 1 upto 40:");
  L("      m := 0.5[a, b];");
  L("      if pm_inbox(c, m): a := m; else: b := m; fi");
  L("    endfor");
  L("    q[i - 1] := b;");
  L("    for k = 0 upto n - i:");
  L("      if start: pm_p[j][k] := q[i - 1 + k]; else: pm_p[j][n - i - k] := q[i - 1 + k]; fi");
  L("    endfor");
  L("    pm_np[j] := n - i + 1;");
  L("  fi");
  L("  endgroup;");
  L("enddef;");
  L("def pm_clipall =");
  L("  for j = 0 upto pm_ne - 1:");
  L("    begingroup save n; n := pm_np[j];");
  L("    if pm_ef[j] = pm_et[j]:");
  L("      pm_p[j][0] := pm_clip(pm_ef[j], pm_p[j][0], pm_p[j][0]);");
  L("      pm_p[j][n - 1] := pm_clip(pm_et[j], pm_p[j][n - 1], pm_p[j][n - 1]);");
  L("    elseif n >= 2:");
  L("      if pm_efc[j] >= 0: pm_cutbox(j, pm_efc[j], true);");
  L("      else: pm_p[j][0] := pm_clip(pm_ef[j], pm_p[j][0], pm_p[j][1]); fi");
  L("      n := pm_np[j];");
  L("      if pm_etc[j] >= 0: pm_cutbox(j, pm_etc[j], false);");
  L("      else: pm_p[j][n - 1] := pm_clip(pm_et[j], pm_p[j][n - 1], pm_p[j][n - 2]); fi");
  L("    fi");
  L("    endgroup;");
  L("  endfor");
  L("enddef;");
  L("def pm_up(expr z) = (xpart z, -ypart z) enddef;");
  L("vardef pm_basis(expr j) =");
  L("  save n, z, p, a, b, s; pair z[], a, b, s; path p;");
  L("  n := pm_np[j];");
  L("  for i = 0 upto n - 1: z[i] := pm_up(pm_p[j][i]); endfor");
  L("  if n = 2: p := z0 -- z1;");
  L("  else:");
  L("    s := (5z0 + z1) / 6;");
  L("    p := z0 .. controls ((2z0 + s) / 3) and ((z0 + 2s) / 3) .. s;");
  L("    a := z0; b := z1;");
  L("    for k = 2 upto n - 1:");
  L("      p := p .. controls ((2a + b) / 3) and ((a + 2b) / 3) .. ((a + 4b + z[k]) / 6);");
  L("      a := b; b := z[k];");
  L("    endfor");
  L("    p := p .. controls ((2a + b) / 3) and ((a + 2b) / 3) .. ((a + 5b) / 6);");
  L("    s := point infinity of p;");
  L("    p := p .. controls ((2s + b) / 3) and ((s + 2b) / 3) .. b;");
  L("  fi");
  L("  p");
  L("enddef;");
  L("vardef pm_col(expr c) = if c >= 0: pm_c[c] else: black fi enddef;");
  L("vardef pm_enddir(expr p) =");
  L("  save d; pair d; d := direction infinity of p;");
  L("  if abs(d) < 1/1000: d := point infinity of p - point (length p - 1/64) of p; fi");
  L("  if abs(d) < 1/1000000: (1, 0) else: unitvector(d) fi");
  L("enddef;");
  L("def pm_head(expr p, l, c) =");
  L("  begingroup save u, e; pair u, e;");
  L("  e := point infinity of p; u := pm_enddir(p);");
  L("  fill (e -- (e - l * u + (l / 2) * (u rotated 90)) -- (e - l * u - (l / 2) * (u rotated 90)) -- cycle)");
  L("    withcolor c;");
  L("  endgroup");
  L("enddef;");
  L("vardef pm_cut(expr p, l) =");
  L("  if arclength p > l: subpath (0, arctime (arclength p - l) of p) of p else: p fi");
  L("enddef;");
  L("def pm_marker(expr kind, p, w, c) =");
  L("  begingroup save u, e, r; pair u, e;");
  L("  e := point infinity of p; u := pm_enddir(p);");
  L("  r := 5.5pm_px; e := e - r * u;");
  L("  if kind = pm_endcircle:");
  L("    fill fullcircle scaled 2r shifted e withcolor c;");
  L("  elseif kind = pm_endcross:");
  L("    r := 0.7r;");
  L("    draw (e + (-r, -r)) -- (e + (r, r)) withpen pencircle scaled w withcolor c;");
  L("    draw (e + (-r, r)) -- (e + (r, -r)) withpen pencircle scaled w withcolor c;");
  L("  fi");
  L("  endgroup");
  L("enddef;");
  L("numeric pm_ecurve[], pm_nb; pair pm_b[];");
  L("def pm_curve(expr j, c) = pm_ecurve[j] := c; enddef;");
  L("def pm_badd(expr z) = pm_b[pm_nb] := z; pm_nb := pm_nb + 1; enddef;");
  L("def pm_bto(expr a, b, z) = pm_badd(a); pm_badd(b); pm_badd(z); enddef;");
  L("def pm_bline(expr z) =");
  L("  begingroup save s; pair s; s := pm_b[pm_nb - 1];");
  L("    if z <> s: pm_bto((2s + z) / 3, (s + 2z) / 3, z); fi");
  L("  endgroup");
  L("enddef;");
  L("vardef pm_sign(expr v) = if v < 0: -1 elseif v > 0: 1 else: 0 fi enddef;");
  L("vardef pm_steffen(suffix q)(expr i) =");
  L("  save h, k, d, e, s, t, u; numeric h, k, d, e, s, t, u;");
  L("  h := xpart q[i] - xpart q[i - 1]; k := xpart q[i + 1] - xpart q[i];");
  L("  d := ypart q[i] - ypart q[i - 1]; e := ypart q[i + 1] - ypart q[i];");
  L("  if (h = 0) and (k = 0): 0");
  L("  elseif h = 0: if d = 0: 0 else: (pm_sign(d) + pm_sign(e / k)) * abs(e / k) fi");
  L("  elseif k = 0: if e = 0: 0 else: (pm_sign(d / h) + pm_sign(e)) * abs(d / h) fi");
  L("  elseif h + k = 0: 0");
  L("  else:");
  L("    s := d / h; t := e / k; u := (s * k + t * h) / (h + k);");
  L("    (pm_sign(s) + pm_sign(t)) * min(abs(s), abs(t), 0.5abs(u))");
  L("  fi");
  L("enddef;");
  L("vardef pm_curved(expr j) =");
  L("  save n, c, z, q, a, b, r, s, t, l, m, p, sw, x, u, v;");
  L("  pair z[], q[], a[], b[], u, v; numeric n, c, r, s, t[], l[], m, x; path p;");
  L("  boolean sw;");
  L("  n := pm_np[j]; c := pm_ecurve[j];");
  L("  for i = 0 upto n - 1: z[i] := pm_up(pm_p[j][i]); endfor");
  L("  pm_nb := 0; pm_badd(z0);");
  L("  if (c = 1) or ((n = 2) and (c < 10)):");
  L("    for k = 1 upto n - 1: pm_bline(z[k]); endfor");
  L("  elseif c <= 4:");
  L("    s := if c = 2: 0.5 elseif c = 3: 0 else: 1 fi;");
  L("    for k = 1 upto n - 1:");
  L("      if s = 0: pm_bline((xpart z[k - 1], ypart z[k]));");
  L("      elseif s = 1: pm_bline((xpart z[k], ypart z[k - 1]));");
  L("      else:");
  L("        x := (1 - s) * xpart z[k - 1] + s * xpart z[k];");
  L("        pm_bline((x, ypart z[k - 1])); pm_bline((x, ypart z[k]));");
  L("      fi");
  L("      pm_bline(z[k]);");
  L("    endfor");
  L("  elseif c <= 6:");
  L("    z[-1] := z0; z[n] := z[n - 1];");
  L("    for k = 0 upto n - 2:");
  L("      if c = 5:");
  L("        pm_bto(z[k] + (z[k + 1] - z[k - 1]) / 6, z[k + 1] - (z[k + 2] - z[k]) / 6, z[k + 1]);");
  L("      else:");
  L("        l0 := abs(z[k] - z[k - 1]); l1 := abs(z[k + 1] - z[k]);");
  L("        l2 := abs(z[k + 2] - z[k + 1]);");
  L("        u := z[k]; v := z[k + 1];");
  L("        if sqrt(l0) > 1/1000000:");
  L("          m := 2l0 + 3sqrt(l0) * sqrt(l1) + l1;");
  L("          u := (z[k] * m - z[k - 1] * l1 + z[k + 1] * l0) / (3sqrt(l0) * (sqrt(l0) + sqrt(l1)));");
  L("        fi");
  L("        if sqrt(l2) > 1/1000000:");
  L("          m := 2l2 + 3sqrt(l2) * sqrt(l1) + l1;");
  L("          v := (z[k + 1] * m + z[k] * l2 - z[k + 2] * l1) / (3sqrt(l2) * (sqrt(l2) + sqrt(l1)));");
  L("        fi");
  L("        pm_bto(u, v, z[k + 1]);");
  L("      fi");
  L("    endfor");
  L("  elseif c = 7:");
  L("    m := n - 1;");
  L("    q0 := (0, 2); a0 := z0 + 2z1;");
  L("    for i = 1 upto m - 2: q[i] := (1, 4); a[i] := 4z[i] + 2z[i + 1]; endfor");
  L("    q[m - 1] := (2, 7); a[m - 1] := 8z[m - 1] + z[m];");
  L("    for i = 1 upto m - 1:");
  L("      r := xpart q[i] / ypart q[i - 1];");
  L("      q[i] := (xpart q[i], ypart q[i] - r); a[i] := a[i] - r * a[i - 1];");
  L("    endfor");
  L("    a[m - 1] := a[m - 1] / ypart q[m - 1];");
  L("    for i = m - 2 downto 0: a[i] := (a[i] - a[i + 1]) / ypart q[i]; endfor");
  L("    b[m - 1] := (z[m] + a[m - 1]) / 2;");
  L("    for i = 0 upto m - 2: b[i] := 2z[i + 1] - a[i + 1]; endfor");
  L("    for i = 0 upto m - 1: pm_bto(a[i], b[i], z[i + 1]); endfor");
  L("  elseif c <= 9:");
  L("    sw := (c = 9);");
  L("    for i = 0 upto n - 1: q[i] := if sw: (ypart z[i], xpart z[i]) else: z[i] fi; endfor");
  L("    for i = 1 upto n - 2: t[i] := pm_steffen(q)(i); endfor");
  L("    x := xpart q1 - xpart q0;");
  L("    t0 := if x = 0: t1 else: (3(ypart q1 - ypart q0) / x - t1) / 2 fi;");
  L("    x := xpart q[n - 1] - xpart q[n - 2];");
  L("    t[n - 1] := if x = 0: t[n - 2]");
  L("      else: (3(ypart q[n - 1] - ypart q[n - 2]) / x - t[n - 2]) / 2 fi;");
  L("    for i = 0 upto n - 2:");
  L("      x := (xpart q[i + 1] - xpart q[i]) / 3;");
  L("      u := q[i] + (x, x * t[i]); v := q[i + 1] - (x, x * t[i + 1]);");
  L("      if sw: u := (ypart u, xpart u); v := (ypart v, xpart v); fi");
  L("      pm_bto(u, v, z[i + 1]);");
  L("    endfor");
  L("  else:");
  L("    for k = 1 upto n - 1:");
  L("      if c = 10:");
  L("        x := (xpart z[k - 1] + xpart z[k]) / 2;");
  L("        pm_bto((x, ypart z[k - 1]), (x, ypart z[k]), z[k]);");
  L("      else:");
  L("        x := (ypart z[k - 1] + ypart z[k]) / 2;");
  L("        pm_bto((xpart z[k - 1], x), (xpart z[k], x), z[k]);");
  L("      fi");
  L("    endfor");
  L("  fi");
  L("  if pm_nb < 4: pm_bto(z0, z0, z0); fi");
  L("  p := pm_b0 .. controls pm_b1 and pm_b2 .. pm_b3;");
  L("  for k = 6 step 3 until pm_nb - 1:");
  L("    p := p .. controls pm_b[k - 2] and pm_b[k - 1] .. pm_b[k];");
  L("  endfor");
  L("  p");
  L("enddef;");
  L("vardef pm_path(expr j) =");
  L("  if not known pm_ecurve[j]: pm_basis(j)");
  L("  elseif (pm_ecurve[j] < 1) or (pm_ecurve[j] > 11): pm_basis(j)");
  L("  else: pm_curved(j) fi");
  L("enddef;");
  L("def pm_drawedge(expr j) =");
  L("  if (pm_evis[j] = 1) and (pm_eline[j] >= 0) and (pm_np[j] >= 2):");
  L("    begingroup save p, q, l, w, c, d; path p, q; color c;");
  L("    p := pm_path(j); l := 8pm_px; w := pm_ewd[j] * pm_em / pm_size;");
  L("    d := pm_edash[j] * pm_em / pm_size; c := pm_c[pm_eline[j]];");
  L("    q := p;");
  L("    if pm_ehead[j] = pm_endarrow: q := pm_cut(q, l); fi");
  L("    if pm_etail[j] = pm_endarrow: q := reverse pm_cut(reverse q, l); fi");
  L("    if d > 0:");
  L("      draw q withpen pencircle scaled w withcolor c dashed dashpattern(on d off d);");
  L("    else:");
  L("      draw q withpen pencircle scaled w withcolor c;");
  L("    fi");
  L("    if pm_ehead[j] = pm_endarrow: pm_head(p, l, c); fi");
  L("    if pm_etail[j] = pm_endarrow: pm_head(reverse p, l, c); fi");
  L("    pm_marker(pm_ehead[j], p, w, c);");
  L("    pm_marker(pm_etail[j], reverse p, w, c);");
  L("    endgroup;");
  L("  fi");
  L("enddef;");
  L("def pm_drawlabel(expr j) =");
  L('  if (pm_elab[j] >= 0) and (pm_elabel[j] <> ""):');
  L("    begingroup save z; pair z;");
  L("    z := pm_up((pm_elx[j], pm_ely[j]));");
  L("    if pm_labelbox:");
  L("      fill unitsquare shifted (-1/2, -1/2) xscaled pm_elw[j] yscaled pm_elh[j] shifted z");
  L("        withcolor pm_labelback;");
  L("    fi");
  L("    draw pm_pic[pm_elab[j]] shifted (z - center pm_pic[pm_elab[j]])");
  L("      withcolor pm_col(pm_etext[j]);");
  L("    endgroup;");
  L("  fi");
  L("enddef;");
  L("color pm_labelback; pm_labelback := (232, 232, 232) / 255;");
  L("boolean pm_labelbox; pm_labelbox := true;");
  L('string pm_title; pm_title := ""; numeric pm_titlec; pm_titlec := -1;');
  L("def pm_paint(expr o, v, filled) =");
  L("  begingroup save w, d; w := pm_lw[v] * pm_em / pm_size; d := pm_dash[v] * pm_em / pm_size;");
  L("  if filled and (pm_fill[v] >= 0) and cycle o: fill o withcolor pm_c[pm_fill[v]]; fi");
  L("  if pm_line[v] >= 0:");
  L("    if d > 0:");
  L("      draw o withpen pencircle scaled w withcolor pm_c[pm_line[v]] dashed dashpattern(on d off d);");
  L("    else:");
  L("      draw o withpen pencircle scaled w withcolor pm_c[pm_line[v]];");
  L("    fi");
  L("  fi");
  L("  endgroup");
  L("enddef;");
  L("vardef pm_rbox(expr c, w, h, r) =");
  L("  save a, b; a := w / 2; b := h / 2;");
  L("  ((-a + r, -b) -- (a - r, -b) .. controls (a - r + r * 0.5523, -b) and (a, -b + r - r * 0.5523)");
  L("   .. (a, -b + r) -- (a, b - r) .. controls (a, b - r + r * 0.5523) and (a - r + r * 0.5523, b)");
  L("   .. (a - r, b) -- (-a + r, b) .. controls (-a + r - r * 0.5523, b) and (-a, b - r + r * 0.5523)");
  L("   .. (-a, b - r) -- (-a, -b + r) .. controls (-a, -b + r - r * 0.5523) and (-a + r - r * 0.5523, -b)");
  L("   .. cycle) shifted c");
  L("enddef;");
  L("def pm_drawnode(expr v) =");
  L("  begingroup save c, w, h, sh, ry, r, d, o, z; pair c, z; path o;");
  L("  c := pm_up((pm_x[v], pm_y[v])); w := pm_w[v]; h := pm_h[v]; sh := pm_shape[v];");
  L("  z := c;");
  L("  if sh = pm_rect: pm_paint(unitsquare shifted (-1/2, -1/2) xscaled w yscaled h shifted c, v, true);");
  L("  elseif sh = pm_round: pm_paint(pm_rbox(c, w, h, 5pm_px), v, true);");
  L("  elseif sh = pm_stadium: pm_paint(pm_rbox(c, w, h, h / 2), v, true);");
  L("  elseif sh = pm_subroutine:");
  L("    pm_paint(unitsquare shifted (-1/2, -1/2) xscaled w yscaled h shifted c, v, true);");
  L("    d := pm_em / 2;");
  L("    pm_paint((c + (-w / 2 + d, -h / 2)) -- (c + (-w / 2 + d, h / 2)), v, false);");
  L("    pm_paint((c + (w / 2 - d, -h / 2)) -- (c + (w / 2 - d, h / 2)), v, false);");
  L("  elseif sh = pm_cylinder:");
  L("    ry := w / 2 / (2.5 + w / 50);");
  L("    o := (c + (-w / 2, h / 2 - ry)) -- (c + (-w / 2, -h / 2 + ry))");
  L("      -- (subpath (4, 8) of fullcircle xscaled w yscaled 2ry shifted (c + (0, -h / 2 + ry)))");
  L("      -- (c + (w / 2, -h / 2 + ry)) -- (c + (w / 2, h / 2 - ry))");
  L("      -- (subpath (0, 4) of fullcircle xscaled w yscaled 2ry shifted (c + (0, h / 2 - ry)))");
  L("      -- cycle;");
  L("    pm_paint(o, v, true);");
  L("    pm_paint(fullcircle xscaled w yscaled 2ry shifted (c + (0, h / 2 - ry)), v, false);");
  L("    z := c - (0, ry);");
  L("  elseif (sh = pm_circle) or (sh = pm_doublecircle):");
  L("    pm_paint(fullcircle scaled w shifted c, v, true);");
  L("    if sh = pm_doublecircle: pm_paint(fullcircle scaled (w - 2pm_em * 5 / 16) shifted c, v, true); fi");
  L("  elseif sh = pm_sub:");
  L("    draw pm_pic[v] shifted (c - center pm_pic[v]);");
  L("  elseif sh = pm_collapsed:");
  L("    pm_paint(pm_rbox(c, w, h, 8pm_px), v, true);");
  L("    z := c + (0, 14pm_px);");
  L("    d := h / 2 - 16pm_px - pm_th[v];");
  L("    if pm_line[v] >= 0:");
  L("      draw (c + (-w / 2 + 8pm_px, d)) -- (c + (w / 2 - 8pm_px, d))");
  L("        withpen pencircle scaled (pm_lw[v] * pm_em / pm_size)");
  L("        withcolor pm_c[pm_line[v]] dashed dashpattern(on 3pm_px off 3pm_px);");
  L("    fi");
  L("    for k = -1 upto 1:");
  L("      fill fullcircle scaled 5pm_px shifted (c + (10 * k * pm_px, d - 10pm_px))");
  L("        withcolor pm_col(pm_line[v]);");
  L("    endfor");
  L("  elseif sh >= pm_datastore:");
  L("    pm_shapedraw(v);");
  L("    for k = 0 upto pm_sn - 1: pm_drawpart(pm_sp[k] yscaled -1, pm_sk[k], v); endfor");
  L("    z := pm_up((pm_slx, pm_sly));");
  L("  else:");
  L("    pm_paint(pm_outline(v) yscaled -1, v, true);");
  L("  fi");
  L('  if (pm_lab[v] <> "") and ((sh < pm_datastore) or (sh = pm_collapsed) or pm_slab):');
  L("    draw pm_pic[v] shifted (z - center pm_pic[v]) withcolor pm_col(pm_text[v]);");
  L("  fi");
  L("  endgroup");
  L("enddef;");
  L("def pm_drawcluster(expr c) =");
  L("  if pm_cmin[c] >= 0:");
  L("    if (pm_cin[c] >= 0) and (abs(pm_ctx[c] - pm_cx[c]) < 0.5) and (pm_cty[c] < pm_cy[c]):");
  L("      begingroup save th, top, d, bot;");
  L("      pm_paint(pm_rbox(pm_up((pm_cx[c], pm_cy[c])), pm_cw[c], pm_ch[c], 5pm_px), pm_nn + c, true);");
  L("      th := ypart urcorner pm_cpic[c] - ypart llcorner pm_cpic[c];");
  L("      top := pm_cy[c] - pm_ch[c] / 2; bot := pm_cy[c] + pm_ch[c] / 2;");
  L("      d := pm_cty[c] + th / 2 + (pm_cty[c] - top - th / 2);");
  L("      fill unitsquare shifted (-1/2, -1/2) xscaled pm_cw[c] yscaled (bot - d)");
  L("        shifted pm_up((pm_cx[c], (d + bot) / 2)) withcolor pm_c[pm_cin[c]];");
  L("      pm_paint(unitsquare shifted (-1/2, -1/2) xscaled pm_cw[c] yscaled (bot - d)");
  L("        shifted pm_up((pm_cx[c], (d + bot) / 2)), pm_nn + c, false);");
  L("      endgroup;");
  L("    else:");
  L("      pm_paint(unitsquare shifted (-1/2, -1/2) xscaled pm_cw[c] yscaled pm_ch[c]");
  L("        shifted pm_up((pm_cx[c], pm_cy[c])), pm_nn + c, true);");
  L("    fi");
  L("    draw pm_cpic[c] shifted (pm_up((pm_ctx[c], pm_cty[c])) - center pm_cpic[c])");
  L("      withcolor pm_col(pm_text[pm_nn + c]);");
  L("  fi");
  L("enddef;");
  L("def pm_drawclusters(expr p) =");
  L("  for c = 0 upto pm_nc - 1:");
  L("    if pm_cparent[c] = p: pm_drawcluster(c); pm_drawclusters(c); fi");
  L("  endfor");
  L("enddef;");
  L("def pm_drawtitle(suffix p) =");
  L("  begingroup save t; picture t;");
  L("  t := textext(pm_title) scaled (18/16);");
  L("  t := t shifted ((xpart llcorner p + xpart urcorner p) / 2");
  L("    - (xpart llcorner t + xpart urcorner t) / 2, ypart urcorner p + 25pm_px);");
  L("  p := image(draw p; draw t withcolor pm_col(pm_titlec));");
  L("  endgroup");
  L("enddef;");
  L("def pm_endsub(expr k) =");
  L("  begingroup save p; picture p;");
  L("  pm_layout;");
  L("  pm_subpic[k] := pm_drawing;");
  L("  endgroup");
  L("enddef;");
  L("def pm_layout =");
  L('  pm_em := xpart urcorner textext("\hbox to 1em{}") - xpart llcorner textext("\hbox to 1em{}");');
  L("  pm_px := pm_em / 16;");
  L("  pm_sizes;");
  L("  pm_depths;");
  L("  pm_positiony;");
  L("  pm_positionx;");
  L("  pm_repair;");
  L("  pm_boxes;");
  L("  pm_routes;");
  L("  pm_turnall;");
  L("  pm_clipall;");
  L("enddef;");
  L("def pm_drawing =");
  L("  image(");
  L("    pm_drawclusters(-1);");
  L("    for j = 0 upto pm_ne - 1: pm_drawedge(j); endfor");
  L("    for j = 0 upto pm_ne - 1: pm_drawlabel(j); endfor");
  L("    for v = 0 upto pm_nn - 1: if pm_kind[v] = 0: pm_drawnode(v); fi endfor");
  L("  )");
  L("enddef;");
  L("def pm_end =");
  L("  begingroup save p; picture p;");
  L("  pm_layout;");
  L("  p := pm_drawing;");
  L('  if pm_title <> "": pm_drawtitle(p); fi');
  L("  if (pm_maxw > 0) and (xpart urcorner p - xpart llcorner p > pm_maxw):");
  L("    p := p scaled (pm_maxw / (xpart urcorner p - xpart llcorner p));");
  L("  fi");
  L("  draw p;");
  L("  endgroup");
  L("enddef;");
END Write;

END PmMpMacros.
