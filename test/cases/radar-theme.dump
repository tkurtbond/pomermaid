title text="A wide title that the margins of this chart cannot hold at all"
config config.radar.width="300"
config config.radar.height="200"
config config.radar.marginLeft="10"
config config.radar.marginRight="120"
config config.radar.axisLabelFactor="1.2"
config config.themeVariables.cScale0="#336699"
config config.themeVariables.radar.axisColor="#aa0000"
config config.themeVariables.radar.axisStrokeWidth="1"
config config.themeVariables.radar.graticuleColor="#99cc99"
config config.themeVariables.radar.graticuleOpacity="0.5"
config config.themeVariables.radar.curveOpacity="0.25"
config config.themeVariables.radar.curveStrokeWidth="3"
config config.themeVariables.radar.axisLabelFontSize="16"
config config.themeVariables.radar.legendFontSize="14"
radar showLegend=false ticks=5 min=0 graticule=polygon width=300 height=200 marginTop=50 marginRight=120 marginBottom=50 marginLeft=10 axisScaleFactor=1 axisLabelFactor=1.2 curveTension=0.17
axis north label="North"
axis east label="East side"
axis south label="South"
axis west label="The West"
axis up label="up"
curve 0 one label="One" values 5 4 3 2 1
