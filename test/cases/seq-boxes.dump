box 0 fill=#00ffff title="Front end"
box 1 title="Back end"
participant "U" type=actor box=0 label="User"
participant "W" type=boundary box=0 label="Web"
participant "S" type=control box=1 label="Service"
participant "D" type=database box=1 label="D"
participant "Q" type=queue label="Q"
participant "E" type=entity label="E"
participant "L" type=collections label="L"
participant "T" type=participant created=2 destroyed=4 label="Token"
0 message "U" -> "W" head=filled number=10 text="Log in"
1 message "W" -> "S" head=filled number=15 text="Check"
2 message "S" -> "T" head=filled number=20 text="Make"
3 message "S" -> "D" head=filled number=25 text="Store"
4 message "T" -> "S" head=cross number=30 text="Done"
5 message "S" -> "Q" head=open number=35 text="Event"
6 message "Q" -> "E" head=filled text="Update"
7 message "E" -> "L" head=filled text="Add"
