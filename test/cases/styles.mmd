flowchart TD
  A:::hot --> B
  classDef hot,cold fill:#f96,stroke:#333,stroke-width:4px
  classDef default fill:#fff
  class A,B cold
  style B fill:#bbf,stroke:#f66,stroke-dasharray: 5 5, color:rgb(1,2,3)
  linkStyle 0 stroke:#ff3,stroke-width:4px
  linkStyle default color:red
  click A callback "tooltip"
  accTitle: A title
  accDescr {
    A description
  }
