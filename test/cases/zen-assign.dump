mirror off
participant "_STARTER_" type=actor label=""
participant "A" type=participant label="A"
participant "B" type=participant label="B"
0 note over "_STARTER_","A" text=md:"1. assign a variable from a sync message."
1 message "_STARTER_" -> "A" head=filled activate text="SyncMessage()"
2 activate "A"
3 message "A" -> "_STARTER_" dotted head=open text="a"
4 deactivate "A"
5 note over "_STARTER_","A" text=md:"1.1. optionally give the variable a type"
6 message "_STARTER_" -> "A" head=filled activate text="SyncMessage()"
7 activate "A"
8 message "A" -> "_STARTER_" dotted head=open text="a:SomeType"
9 deactivate "A"
10 note over "_STARTER_","A" text=md:"2. use return keyword"
11 message "_STARTER_" -> "A" head=filled activate text="SyncMessage()"
12 activate "A"
13 message "A" -> "_STARTER_" dotted head=open text="result"
14 deactivate "A"
15 note over "A","B" text=md:"3. use @return or @reply annotator on an async message"
16 message "A" -> "B" dotted head=open text="result"
