\startMPcode
numeric pmtpx, pmttop, pmtsech, pmttaskh, pmtstack, pmtsum, pmtpy, pmtey, pmtay,
  pmtaya, pmtayb, pmtspacing, pmtbottom, pmtwidth, pmth[], pmty[], pmtla[], pmtlb[];
picture pmtt[], pmttitle; pair pmtu;
pmtpx := 0.625pt;
vardef pmtp(expr a, b) = (a, -b) enddef;
vardef pmtwd(expr p) = (xpart urcorner p - xpart llcorner p) enddef;
vardef pmtht(expr p) = (ypart urcorner p - ypart llcorner p) enddef;
def pmtarrow(expr a, b, len, wide, w, dsh) =
  pmtu := unitvector(b - a);
  draw a -- (b - len * pmtu) if dsh: dashed dashpattern(on (5*pmtpx) off (5*pmtpx)) fi
    withcolor (0,0,0) withpen pencircle scaled w;
  fill (b - len * pmtu + (wide / 2) * (pmtu rotated 90)) -- b
    -- (b - len * pmtu - (wide / 2) * (pmtu rotated 90)) -- cycle withcolor (0,0,0);
enddef;
def pmtnode(expr xa, ya, w, h, p, f, c, tc) =
  fill pmtp(xa, ya + h) -- pmtp(xa, ya + (5*pmtpx)) {up} .. {right} pmtp(xa + (5*pmtpx), ya)
    -- pmtp(xa + w - (5*pmtpx), ya) {right} .. {down} pmtp(xa + w, ya + (5*pmtpx))
    -- pmtp(xa + w, ya + h) -- cycle withcolor f;
  draw pmtp(xa, ya + h) -- pmtp(xa + w, ya + h) withcolor c withpen pencircle scaled (3*pmtpx);
  draw p shifted (pmtp(xa + w / 2, ya + h / 2) - center p) withcolor tc;
enddef;
pmttop := (10*pmtpx);
pmttitle := textext("{\bf " & "Timeline of Industrial Revolution" & "}") scaled 1.5;
pmttop := pmttop + pmtht(pmttitle) + (15*pmtpx);
pmtsech := 0; pmttaskh := 0; pmtstack := 0;
pmtt[0] := textext("\framed[frame=off,offset=0pt,width=362.5pt,align=middle]{" & "17th-20th century" & "}");
pmth[0] := max(pmtht(pmtt[0]) + (13.8*pmtpx), (0*pmtpx));
pmtsech := max(pmtsech, pmth[0]);
pmtt[1] := textext("\framed[frame=off,offset=0pt,width=125pt,align=middle]{" & "Industry 1.0" & "}");
pmth[1] := max(pmtht(pmtt[1]) + (13.8*pmtpx), (0*pmtpx));
pmttaskh := max(pmttaskh, pmth[1]);
pmtsum := 0;
pmtt[2] := textext("\framed[frame=off,offset=0pt,width=187.5pt,align=middle]{" & "Machinery, Water power, Steam\\power" & "}");
pmth[2] := max(pmtht(pmtt[2]) + (13.8*pmtpx), (0*pmtpx));
pmtsum := pmtsum + pmth[2];
pmtstack := max(pmtstack, pmtsum);
pmtt[3] := textext("\framed[frame=off,offset=0pt,width=125pt,align=middle]{" & "Industry 2.0" & "}");
pmth[3] := max(pmtht(pmtt[3]) + (13.8*pmtpx), (0*pmtpx));
pmttaskh := max(pmttaskh, pmth[3]);
pmtsum := 0;
pmtt[4] := textext("\framed[frame=off,offset=0pt,width=187.5pt,align=middle]{" & "Electricity, Internal combustion engine, Mass production" & "}");
pmth[4] := max(pmtht(pmtt[4]) + (13.8*pmtpx), (0*pmtpx));
pmtsum := pmtsum + pmth[4];
pmtstack := max(pmtstack, pmtsum);
pmtt[5] := textext("\framed[frame=off,offset=0pt,width=125pt,align=middle]{" & "Industry 3.0" & "}");
pmth[5] := max(pmtht(pmtt[5]) + (13.8*pmtpx), (0*pmtpx));
pmttaskh := max(pmttaskh, pmth[5]);
pmtsum := 0;
pmtt[6] := textext("\framed[frame=off,offset=0pt,width=187.5pt,align=middle]{" & "Electronics, Computers, Automation" & "}");
pmth[6] := max(pmtht(pmtt[6]) + (13.8*pmtpx), (0*pmtpx));
pmtsum := pmtsum + pmth[6];
pmtstack := max(pmtstack, pmtsum);
pmtt[7] := textext("\framed[frame=off,offset=0pt,width=362.5pt,align=middle]{" & "21st century" & "}");
pmth[7] := max(pmtht(pmtt[7]) + (13.8*pmtpx), (0*pmtpx));
pmtsech := max(pmtsech, pmth[7]);
pmtt[8] := textext("\framed[frame=off,offset=0pt,width=125pt,align=middle]{" & "Industry 4.0" & "}");
pmth[8] := max(pmtht(pmtt[8]) + (13.8*pmtpx), (0*pmtpx));
pmttaskh := max(pmttaskh, pmth[8]);
pmtsum := 0;
pmtt[9] := textext("\framed[frame=off,offset=0pt,width=187.5pt,align=middle]{" & "Internet, Robotics, Internet of Things" & "}");
pmth[9] := max(pmtht(pmtt[9]) + (13.8*pmtpx), (0*pmtpx));
pmtsum := pmtsum + pmth[9];
pmtstack := max(pmtstack, pmtsum);
pmtt[10] := textext("\framed[frame=off,offset=0pt,width=125pt,align=middle]{" & "Industry 5.0" & "}");
pmth[10] := max(pmtht(pmtt[10]) + (13.8*pmtpx), (0*pmtpx));
pmttaskh := max(pmttaskh, pmth[10]);
pmtsum := 0;
pmtt[11] := textext("\framed[frame=off,offset=0pt,width=187.5pt,align=middle]{" & "Artificial intelligence, Big data, 3D printing" & "}");
pmth[11] := max(pmtht(pmtt[11]) + (13.8*pmtpx), (0*pmtpx));
pmtsum := pmtsum + pmth[11];
pmtstack := max(pmtstack, pmtsum);
pmth[0] := pmtsech;
pmth[1] := pmttaskh;
pmth[3] := pmttaskh;
pmth[5] := pmttaskh;
pmth[7] := pmtsech;
pmth[8] := pmttaskh;
pmth[10] := pmttaskh;
pmtspacing := max(pmttaskh, pmtstack) + (30*pmtpx);
pmtpy := pmttop + (32*pmtpx);
pmtbottom := pmttop;
pmty[0] := pmtpy; pmtpy := pmtpy + pmtsech + (20*pmtpx);
pmtbottom := max(pmtbottom, pmtpy - (20*pmtpx));
pmty[1] := pmtpy;
pmtbottom := max(pmtbottom, pmtpy + pmttaskh);
pmtey := pmtpy;
pmty[2] := pmtey; pmtla[0] := pmtey + pmth[2] / 2; pmtlb[0] := pmtla[0];
pmtey := pmtey + pmth[2]; pmtbottom := max(pmtbottom, pmtey); pmtey := pmtey + (10*pmtpx);
pmtpy := pmtpy + pmtspacing;
pmty[3] := pmtpy;
pmtbottom := max(pmtbottom, pmtpy + pmttaskh);
pmtey := pmtpy;
pmty[4] := pmtey; pmtla[1] := pmtey + pmth[4] / 2; pmtlb[1] := pmtla[1];
pmtey := pmtey + pmth[4]; pmtbottom := max(pmtbottom, pmtey); pmtey := pmtey + (10*pmtpx);
pmtpy := pmtpy + pmtspacing;
pmty[5] := pmtpy;
pmtbottom := max(pmtbottom, pmtpy + pmttaskh);
pmtey := pmtpy;
pmty[6] := pmtey; pmtla[2] := pmtey + pmth[6] / 2; pmtlb[2] := pmtla[2];
pmtey := pmtey + pmth[6]; pmtbottom := max(pmtbottom, pmtey); pmtey := pmtey + (10*pmtpx);
pmtpy := pmtpy + pmtspacing;
pmtpy := pmtpy - (10*pmtpx);
pmty[7] := pmtpy; pmtpy := pmtpy + pmtsech + (20*pmtpx);
pmtbottom := max(pmtbottom, pmtpy - (20*pmtpx));
pmty[8] := pmtpy;
pmtbottom := max(pmtbottom, pmtpy + pmttaskh);
pmtey := pmtpy;
pmty[9] := pmtey; pmtla[3] := pmtey + pmth[9] / 2; pmtlb[3] := pmtla[3];
pmtey := pmtey + pmth[9]; pmtbottom := max(pmtbottom, pmtey); pmtey := pmtey + (10*pmtpx);
pmtpy := pmtpy + pmtspacing;
pmty[10] := pmtpy;
pmtbottom := max(pmtbottom, pmtpy + pmttaskh);
pmtey := pmtpy;
pmty[11] := pmtey; pmtla[4] := pmtey + pmth[11] / 2; pmtlb[4] := pmtla[4];
pmtey := pmtey + pmth[11]; pmtbottom := max(pmtbottom, pmtey); pmtey := pmtey + (10*pmtpx);
pmtpy := pmtpy + pmtspacing;
pmtaya := pmttop; pmtayb := max(pmtbottom, pmttop + (32*pmtpx)) + (28*pmtpx);
pmtbottom := pmtayb;
pmtarrow(pmtp((150pt), pmtaya), pmtp((150pt), pmtayb), (24*pmtpx), (16*pmtpx), (4*pmtpx), false);
pmtarrow(pmtp((150pt), pmtla[0]), pmtp((181.25pt), pmtlb[0]), (12*pmtpx), (8*pmtpx), (2*pmtpx), true);
pmtarrow(pmtp((150pt), pmtla[1]), pmtp((181.25pt), pmtlb[1]), (12*pmtpx), (8*pmtpx), (2*pmtpx), true);
pmtarrow(pmtp((150pt), pmtla[2]), pmtp((181.25pt), pmtlb[2]), (12*pmtpx), (8*pmtpx), (2*pmtpx), true);
pmtarrow(pmtp((150pt), pmtla[3]), pmtp((181.25pt), pmtlb[3]), (12*pmtpx), (8*pmtpx), (2*pmtpx), true);
pmtarrow(pmtp((150pt), pmtla[4]), pmtp((181.25pt), pmtlb[4]), (12*pmtpx), (8*pmtpx), (2*pmtpx), true);
pmtnode((6.25pt), pmty[0], (368.75pt), pmth[0], pmtt[0], (0.5255,0.5255,1), (1,1,0.7255), (1,1,1));
pmtnode((6.25pt), pmty[1], (131.25pt), pmth[1], pmtt[1], (0.5255,0.5255,1), (1,1,0.7255), (1,1,1));
pmtnode((181.25pt), pmty[2], (193.75pt), pmth[2], pmtt[2], (0.6314,0.6314,1), (1,1,0.8706), (1,1,1));
pmtnode((6.25pt), pmty[3], (131.25pt), pmth[3], pmtt[3], (0.5255,0.5255,1), (1,1,0.7255), (1,1,1));
pmtnode((181.25pt), pmty[4], (193.75pt), pmth[4], pmtt[4], (0.6314,0.6314,1), (1,1,0.8706), (1,1,1));
pmtnode((6.25pt), pmty[5], (131.25pt), pmth[5], pmtt[5], (0.5255,0.5255,1), (1,1,0.7255), (1,1,1));
pmtnode((181.25pt), pmty[6], (193.75pt), pmth[6], pmtt[6], (0.6314,0.6314,1), (1,1,0.8706), (1,1,1));
pmtnode((6.25pt), pmty[7], (368.75pt), pmth[7], pmtt[7], (1,1,0.4706), (0.6706,0.6706,1), (0,0,0));
pmtnode((6.25pt), pmty[8], (131.25pt), pmth[8], pmtt[8], (1,1,0.4706), (0.6706,0.6706,1), (0,0,0));
pmtnode((181.25pt), pmty[9], (193.75pt), pmth[9], pmtt[9], (1,1,0.5647), (0.8039,0.8039,1), (0,0,0));
pmtnode((6.25pt), pmty[10], (131.25pt), pmth[10], pmtt[10], (1,1,0.4706), (0.6706,0.6706,1), (0,0,0));
pmtnode((181.25pt), pmty[11], (193.75pt), pmth[11], pmtt[11], (1,1,0.5647), (0.8039,0.8039,1), (0,0,0));
draw pmttitle shifted (pmtp((6.25pt), (10*pmtpx)) - ulcorner pmttitle) withcolor (0.2,0.2,0.2);
pmtwidth := max((375pt), (6.25pt) + pmtwd(pmttitle));
pmtwidth := pmtwidth + (10*pmtpx); pmtbottom := pmtbottom + (10*pmtpx);
setbounds currentpicture to pmtp(0, 0) -- pmtp(pmtwidth, 0) -- pmtp(pmtwidth, pmtbottom) -- pmtp(0, pmtbottom) -- cycle;
if pmtwidth > 432pt: currentpicture := currentpicture scaled (432pt / pmtwidth); fi
\stopMPcode
