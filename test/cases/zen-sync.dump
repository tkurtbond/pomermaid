title text="Sync message"
mirror off
participant "_STARTER_" type=actor label=""
participant "A" type=participant label="A"
participant "B" type=participant label="B"
0 message "_STARTER_" -> "A" head=filled activate text="SyncMessage"
1 activate "A"
2 deactivate "A"
3 message "_STARTER_" -> "A" head=filled activate text="SyncMessage(with,parameters)"
4 activate "A"
5 message "A" -> "B" head=filled activate text="nestedSyncMessage()"
6 activate "B"
7 deactivate "B"
8 deactivate "A"
