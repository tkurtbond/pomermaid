title text="A themed journey with a much longer title than its tasks need"
config config.themeVariables.fillType0="#ffcccc"
config config.themeVariables.fillType1="#ccffcc"
config config.themeVariables.actor0="#ff0000"
config config.themeVariables.actor1="#0000ff"
config config.themeVariables.faceColor="#ffff00"
actor 0 "A person with a name long enough to wrap in the legend because it is wider than three hundred and sixty pixels"
actor 1 "Alice"
actor 2 "Bob"
section 0 tasks=0..0 text="First"
section 1 tasks=1..1 text="Second"
task 0 score=4 section=0 people=1,2 text="Start"
task 1 score=2 section=1 people=2,0 text="Finish"
