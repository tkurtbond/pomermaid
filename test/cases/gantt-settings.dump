title text="Settings"
config displayMode="compact"
config config.gantt.barHeight="30"
dateFormat "YYYY-MM-DD"
axisFormat "%m/%d"
tickInterval "1week"
todayMarker "stroke-width:5px,stroke:#0f0"
includes "2014-01-11"
excludes "weekends" "2014-01-15" "wednesday"
weekday 1 weekend 5 inclusiveEndDates compact
