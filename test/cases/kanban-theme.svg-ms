box wid 1.172 ht 0.34 rad 0.043 at (2.083, -0.757) shaded "pm-ffffee" outlined "pm-0000ff" thickness 0.625
"\s[10]\f[TS]\m[pm-990000]Two\m[]\f[]\s[0]"  at (1.696, -0.757)
.PE
