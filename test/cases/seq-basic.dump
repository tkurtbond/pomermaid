title text="Ordering"
participant "C" type=actor label="Customer"
participant "W" type=participant label="Web app"
participant "A" type=participant label="API"/"gateway"
participant "Bank" type=participant label="Bank"
0 message "C" -> "W" head=filled text="Place order"
1 message "W" -> "A" head=filled activate text="POST /orders"
2 activate "A"
3 message "A" -> "Bank" head=filled text="Authorise payment"
4 message "Bank" -> "A" dotted head=filled text="Approved"
5 note over "A","Bank" text="One order, one transaction"
6 message "A" -> "W" dotted head=filled text="201 Created"
7 deactivate "A"
8 note right of "W" text="Shows the receipt"
9 message "W" -> "C" dotted head=filled text="Order confirmed"
10 note left of "C" text="Happy"
11 message "C" -> "C" head=filled text="Thinks"
