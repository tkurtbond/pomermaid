"\M[pm-333333]\v'-0.22m'\D'P -0.087i -0.044i 0i 0.087i'\M[]" ljust at (2.387, -0.957)
"\f[TS]\m[pm-333333]hi\m[]\f[]"  at (1.519, -0.821)
box wid 2.17 ht 0.34 at (1.519, -1.214) shaded "pm-00ff00" outlined "pm-aaaa33" thickness 0.625
"\f[TS]\m[pm-000000]n\m[]\f[]"  at (1.519, -1.214)
box wid 1.302 ht 0.564 at (0.651, -0.282) rad 0.026 shaded "pm-ff0000" outlined "pm-9370db" thickness 0.625
"\f[TS]\m[pm-000000]A\m[]\f[]"  at (0.651, -0.282)
box wid 1.302 ht 0.564 at (0.651, -1.839) rad 0.026 shaded "pm-ff0000" outlined "pm-9370db" thickness 0.625
"\f[TS]\m[pm-000000]A\m[]\f[]"  at (0.651, -1.839)
box wid 1.302 ht 0.564 at (2.387, -0.282) rad 0.026 shaded "pm-ff0000" outlined "pm-9370db" thickness 0.625
"\f[TS]\m[pm-000000]B\m[]\f[]"  at (2.387, -0.282)
box wid 1.302 ht 0.564 at (2.387, -1.839) rad 0.026 shaded "pm-ff0000" outlined "pm-9370db" thickness 0.625
"\f[TS]\m[pm-000000]B\m[]\f[]"  at (2.387, -1.839)
.PE
.ps \n[pm*ps]u
.vs \n[pm*vs]u
