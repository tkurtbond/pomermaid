shape index=0 type=container alias="spa" parent="global" label="Single Page Application" techn="javascript and angular" descr="Provides all the internet banking functionality to customers via their web browser."
shape index=1 type=container_db alias="db" parent="global" label="Database" techn="Relational Database Schema" descr="Stores user registration information, hashed authentication credentials, access logs, etc."
shape index=2 type=external_system alias="mbs" parent="global" label="Mainframe Banking System" descr="Stores all of the core banking information about customers, accounts, transactions, etc."
shape index=3 type=component alias="sign" parent="api" label="Sign In Controller" techn="MVC Rest Controller" descr="Allows users to sign in to the internet banking system"
shape index=4 type=component alias="accounts" parent="api" label="Accounts Summary Controller" techn="MVC Rest Controller" descr="Provides customers with a summary of their bank accounts"
shape index=5 type=component alias="security" parent="api" label="Security Component" techn="Spring Bean" descr="Provides functionality related to singing in, changing passwords, etc."
shape index=6 type=component_db alias="cache" parent="api" label="Cache" techn="Redis" descr=""
shape index=7 type=external_component_queu alias="events" parent="api" label="Events" techn="Kafka" descr=""
shape index=8 type=external_component alias="mbsfacade" parent="api" label="Mainframe Banking System Facade" techn="Spring Bean" descr="A facade onto the mainframe banking system."
