title text="Reach and engagement of campaigns"
quadrantChart width=500 height=500 xAxis=top yAxis=left
sizes titlePadding=10 titleFontSize=20 quadrantPadding=5 quadrantTextTopPadding=5 quadrantLabelFontSize=16 xAxisLabelPadding=5 yAxisLabelPadding=5 xAxisLabelFontSize=16 yAxisLabelFontSize=16 pointTextPadding=5 pointLabelFontSize=12 pointRadius=5 internalBorder=1 externalBorder=2
quadrant 1 text="We should expand"
quadrant 2 text="Need to promote"
quadrant 3 text="Re-evaluate"
quadrant 4 text="May be improved"
x-axis from="Low Reach" to="High Reach"
y-axis from="Low Engagement" to="High Engagement"
classDef class3 radius=10 color=#f00fff
classDef class2 radius=10 color=#908342 stroke=#310085 strokeWidth=10
classDef class1 color=#109060
point text="Campaign F" at=(0.4,0.5) class=class3 color=#0000ff
point text="Campaign E" at=(0.5,0.4) class=class2
point text="Campaign D" at=(0.6,0.3) radius=15 color=#ff33f0 stroke=#00ff0f strokeWidth=5
point text="Campaign C" at=(0.7,0.2) radius=25 color=#00ff33 stroke=#10f0f0
point text="Campaign B" at=(0.8,0.1) class=class1 radius=10 color=#ff3300
point text="Campaign A" at=(0.9,0) radius=12
