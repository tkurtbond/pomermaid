config config.mindmap.colorBy="depth"
config config.mindmap.padding="6"
config config.mindmap.maxNodeWidth="120"
mindmap padding=6 maxNodeWidth=120 colorBy=depth nodes=10
node 0 level=0 depth=0 section=-1 shape=circle id="root" label=md:"The root"
node 1 parent=0 level=2 depth=1 section=0 shape=default id="A" label=md:"A"
node 2 parent=1 level=4 depth=2 section=1 shape=default id="A1" label=md:"A1"
node 3 parent=2 level=6 depth=3 section=2 shape=default id="A11" label=md:"A11"
node 4 parent=3 level=8 depth=4 section=3 shape=default id="A111" label=md:"A111"
node 5 parent=4 level=10 depth=5 section=4 shape=default id="A1111 with a label long enough to wrap twice at this width" label=md:"A1111 with a label long enough to wrap twice at this width"
node 6 parent=0 level=2 depth=1 section=0 shape=default id="B" label=md:"B"
node 7 parent=6 level=4 depth=2 section=1 shape=default id="B1" label=md:"B1"
node 8 parent=6 level=4 depth=2 section=1 shape=default id="B2" label=md:"B2"
node 9 parent=0 level=2 depth=1 section=0 shape=default id="C" label=md:"C"
