---
title: Settings
displayMode: compact
config:
  gantt:
    barHeight: 30
---
gantt
    dateFormat YYYY-MM-DD
    axisFormat %m/%d
    tickInterval 1week
    todayMarker stroke-width:5px,stroke:#0f0
    inclusiveEndDates
    weekday monday
    weekend friday
    excludes weekends, 2014-01-15 Wednesday
    includes 2014-01-11
    section One
    A :a, 2014-01-06, 2014-01-08
    B :b, after a missing, 3d
    C :until nothing other
    D :d, 2014-01-20, 3x
    E :vert, v, 2014-01-21, 0d
    F :2014-01-22T10:00, 1.5d
    G :g, 2014-01-24, 1M
