title text="Order Service"
mirror off
box 0 title="BusinessService"
participant "Client" type=actor label="Client"
participant "OrderController" type=boundary label="«BFF»"/"OrderController"
participant "OrderService" type=control box=0 label="OrderService"
participant "DB" type=database box=0 label="Order DB"
participant "order:Order" type=participant created=5 label="order:Order"
participant "PurchaseService" type=participant label="PurchaseService"
participant "Notifier" type=participant label="Notifier"
0 note over "Client","OrderController" text=md:"`POST /orders`"
1 message "Client" -> "OrderController" head=filled activate text="post(payload)"
2 activate "OrderController"
3 message "OrderController" -> "OrderService" head=filled activate text="create(payload)"
4 activate "OrderService"
5 message "OrderService" -> "order:Order" dotted head=open activate text="«payload,status=new»"
6 activate "order:Order"
7 message "order:Order" -> "OrderService" dotted head=open text="order"
8 deactivate "order:Order"
9 start alt text="order != null"
10 start par
11 message "OrderService" -> "DB" head=filled activate text="save(order)"
12 activate "DB"
13 deactivate "DB"
14 message "OrderService" -> "PurchaseService" head=filled activate text="charge(order.amount)"
15 activate "PurchaseService"
16 message "PurchaseService" -> "OrderService" dotted head=open text="ok"
17 deactivate "PurchaseService"
18 end par
19 section alt text="retry"
20 start ref
21 note over "OrderService","DB" text="Retry"
22 end ref
23 section alt text="else"
24 message "OrderService" -> "OrderController" dotted head=open text="error"
25 end alt
26 deactivate "OrderService"
27 note over "Client","Notifier" text="Respond"
28 start section text="Notify"
29 message "Notifier" -> "Client" head=open text="done"
30 end section
31 message "OrderController" -> "OrderService" head=filled activate text="id()"
32 activate "OrderService"
33 message "OrderService" -> "OrderController" dotted head=open text="id:int"
34 deactivate "OrderService"
35 start loop text="item in items"
36 message "OrderController" -> "OrderService" head=filled activate text="ship(item)"
37 activate "OrderService"
38 deactivate "OrderService"
39 end loop
40 start critical text="lock"
41 message "OrderController" -> "OrderController" head=filled activate text="x = self()"
42 activate "OrderController"
43 deactivate "OrderController"
44 end critical
45 deactivate "OrderController"
