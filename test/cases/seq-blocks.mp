\startMPcode
input pomermaid-seq ;
pms_begin(432, 3, 31, 0, 1);
pms_colour(0, 0.9255, 0.9255, 1);
pms_colour(1, 0.5765, 0.4392, 0.8588);
pms_colour(2, 0, 0, 0);
pms_colour(3, 0.2, 0.2, 0.2);
pms_colour(4, 1, 0.9608, 0.6784);
pms_colour(5, 0.6667, 0.6667, 0.2);
pms_colour(6, 0.9569, 0.9569, 0.9569);
pms_colour(7, 0.4, 0.4, 0.4);
pms_colour(8, 1, 1, 1);
pms_colour(9, 0.502, 0.502, 0.502);
pms_colour(10, 0.902, 0.902, 1);
pms_theme(0, 1, 2, 1, 3, 3, 0, 1, 2, 2, 4, 5, 2, 6, 7, 3, 8, 3, 9);
pms_actor(0, 0, -1, -1, -1, "Alice");
pms_actor(1, 0, -1, -1, -1, "John");
pms_actor(2, 0, -1, -1, -1, "Bob");
pms_msg(0, 0, 1, 0, 1, 0, 0, 0, 0, "1", "Hello John, how are you?");
pms_start(1, 0, -1, "Every minute");
pms_msg(2, 1, 0, 1, 1, 0, 0, 0, 0, "2", "Great!");
pms_stop(3);
pms_start(4, 2, -1, "is sick");
pms_msg(5, 2, 0, 0, 1, 0, 0, 0, 0, "3", "Not so good :(");
pms_else(6, "is well");
pms_msg(7, 2, 0, 0, 1, 0, 0, 0, 0, "4", "Feeling fresh like a daisy");
pms_stop(8);
pms_start(9, 1, -1, "Extra response");
pms_msg(10, 2, 0, 0, 1, 0, 0, 0, 0, "5", "Thanks for asking");
pms_stop(11);
pms_start(12, 3, -1, "Alice to Bob");
pms_msg(13, 0, 2, 0, 1, 0, 0, 0, 0, "6", "Hello guys!");
pms_else(14, "Alice to John");
pms_msg(15, 0, 1, 0, 1, 0, 0, 0, 0, "7", "Hello guys!");
pms_stop(16);
pms_start(17, 5, -1, "Connect");
pms_msg(18, 1, 2, 1, 0, 0, 0, 0, 0, "8", "connect");
pms_else(19, "Timeout");
pms_msg(20, 1, 1, 1, 0, 0, 0, 0, 0, "9", "Log error");
pms_stop(21);
pms_start(22, 6, -1, "when it fails");
pms_msg(23, 2, 0, 1, 0, 0, 0, 0, 0, "10", "show failure");
pms_stop(24);
pms_start(25, 7, 10, "");
pms_msg(26, 0, 1, 0, 1, 0, 1, 0, 0, "11", "Inside a rect");
pms_activate(27, 1);
pms_msg(28, 1, 0, 1, 1, 0, 0, 0, 0, "12", "Back");
pms_deactivate(29, 1);
pms_stop(30);
pms_end;
\stopMPcode
