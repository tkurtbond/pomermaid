"\M[pm-333333]\v'-0.22m'\D'P -0.069i 0.034i 0i -0.069i'\M[]" ljust at (1.321, -1.905)
line from (1.321, -1.905) to (1.252, -1.939) to (1.252, -1.87) to (1.321, -1.905) outlined "pm-333333" thickness 0
line from (1.252, -1.905) to (1.286, -1.905) outlined "pm-333333" thickness 1.25
