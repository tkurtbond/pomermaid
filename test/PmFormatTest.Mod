MODULE PmFormatTest;
(* Tests of PmFormat, against d3-format 3.1.0's outputs *)

IMPORT F := PmFormat, PmIO;

PROCEDURE T(spec: ARRAY OF CHAR; x: LONGREAL; want: ARRAY OF CHAR);
  VAR f: F.Format; s: ARRAY 4400 OF CHAR;
BEGIN
  IF ~F.New(spec, f) THEN s := "(invalid)" ELSE F.Apply(f, x, s) END;
  IF s = want THEN PmIO.WriteString("ok   - ") ELSE PmIO.WriteString("FAIL - ") END;
  PmIO.WriteString(spec); PmIO.WriteString(" "); PmIO.WriteString(s);
  IF s # want THEN PmIO.WriteString(" want "); PmIO.WriteString(want) END;
  PmIO.WriteLn
END T;

BEGIN
  T(",", 1234567, "1,234,567");
  T(",", 1234.5678D0, "1,234.5678");
  T(",", 0.1D0 + 0.2D0, "0.3");
  T(",", 1.0D21, "1e+21");
  T("", 1234567, "1234567");
  T(".2f", 3.14159D0, "3.14");
  T(".2f", 1.005D0, "1.00");
  T(".1f", 0.25, "0.3");
  T(".0f", 0.5, "1");
  T(".0f", 2.5, "3");
  T(".1f", 1.45D0, "1.4");
  T(".20f", 0.1D0, "0.10000000000000000555");
  T(".2f", 1.0D21, "1e+21");
  T(".2f", -0.001D0, "0.00");
  T("+.2f", -0.001D0, "−0.00");
  T("+.2f", 1.5, "+1.50");
  T("(.2f", -1.5, "(1.50)");
  T(" .2f", 1.5, " 1.50");
  T("$,.2f", 1234.5, "$1,234.50");
  T(".0%", 0.123D0, "12%");
  T("+.2%", -0.123D0, "−12.30%");
  T(".3s", 42.0D6, "42.0M");
  T("s", 1500, "1.50000k");
  T("~s", 1500, "1.5k");
  T("s", 0.0000005D0, "500.000n");
  T(".2s", 0.000001D0, "1.0µ");
  T("d", 42.6, "43");
  T("d", -42.5, "−43");
  T(",d", 1234567.4D0, "1,234,567");
  T("x", 255, "ff");
  T("#x", 255, "0xff");
  T("#X", 255, "0xFF");
  T("b", 5, "101");
  T("o", 8, "10");
  T("#b", 1.0D20, "0b1010110101111000111010111100010110101100011000100000000000000000000");
  T("e", 12345, "1.234500e+4");
  T(".3e", 0.000123456D0, "1.235e-4");
  T(".3e", 1.0D-320, "1.000e-320");
  T(".0e", 0, "0e+0");
  T("08.2f", -3.5, "−0003.50");
  T("^10", 42, "    42    ");
  T("^9", 42, "   42    ");
  T("*<8", 1.5, "1.5*****");
  T("=+8", 42, "+     42");
  T("010,", 1234567, "01,234,567");
  T("012,.2f", 1234.5, "0,001,234.50");
  T(".2r", 1234, "1200");
  T("r", 0.000123456789D0, "0.000123457");
  T(".3p", 0.1234D0, "12.3%");
  T("c", 5, "5");
  T("$c", -2.5, "$-2.5");
  T("g", 1.0D-7, "1.00000e-7");
  T(".3g", 1234, "1.23e+3");
  T(".3g", 0.001234D0, "0.00123");
  T(".3n", 1234567, "1.23e+6");
  T("n", 1234, "1,234.00");
  T("E", 1.5, "1.5");
  T(".2", 1234, "1.2e+3");
  T(",.2", 1234, "1.2e+3");
  T("~f", 1.5, "1.5");
  T(".3~e", 1500, "1.5e+3");
  T(",.2f", 1.0D6, "1,000,000.00");
  T("f", 0, "0.000000");
  T("$", 12, "$12");
  T(".2q", 1, "1");
  T("é>5", 1, "éééé1");
  T(".", 1, "(invalid)");
  T("5.2f!", 1, "(invalid)");
  T("1001", 1, "(invalid)");
  PmIO.CloseOutput
END PmFormatTest.
